<project name="dbnavigator" default="all">
    <echo level="info" message="java.home = ${java.home}"/>
    <property file="build.properties"/>
    <property name="skip.tests" value="true"/>

    <!-- Compiler options -->
    <patternset id="compiler.ignored.files">
        <exclude name="**/CVS/**"/>
        <exclude name="**/SCCS/**"/>
        <exclude name="**/RCS/**"/>
        <exclude name="**/rcs/**"/>
        <exclude name="**/.DS_Store/**"/>
        <exclude name="**/.svn/**"/>
        <exclude name="**/*.awf/**"/>
        <exclude name="**/*.iml/**"/>
        <exclude name="**/vssver.scc/**"/>
        <exclude name="**/vssver2.scc/**"/>
        <exclude name="**/.sbas/**"/>
        <exclude name="**/.IJI.*/**"/>
        <exclude name="**/.cvsignore/**"/>
        <exclude name="**/.*/**"/>
    </patternset>
    <patternset id="compiler.resources">
        <include name="**/?*.properties"/>
        <include name="**/?*.xml"/>
        <include name="**/?*.gif"/>
        <include name="**/?*.png"/>
        <include name="**/?*.svg"/>
        <include name="**/?*.jpeg"/>
        <include name="**/?*.jpg"/>
        <include name="**/?*.html"/>
        <include name="**/?*.dtd"/>
        <include name="**/?*.tld"/>
        <include name="**/?*.txt"/>
        <include name="**/?*.ft"/>
    </patternset>
    <patternset id="svg.resources">
        <include name="**/?*.svg"/>
    </patternset>

    <dirname property="root.dir" file="${ant.file}/.."/>
    <property name="source.dir" value="${root.dir}/src"/>
    <property name="resource.dir" value="${root.dir}/src/main/resources"/>
    <property name="compiler.output.dir" value="${root.dir}/classes"/>
    <property name="distribution.dir" value="${root.dir}/dist"/>
<!--
    <property name="deployment.dir" value="${idea.plugins.sandbox}/DBNavigator"/>
-->

    <path id="source.dir">
        <dirset dir="${root.dir}">
            <include name="src"/>
        </dirset>
    </path>

    <path id="classpath.ide">
        <fileset dir="${idea.home}">
            <include name="lib/*.jar"/>
            <include name="redist/*.jar"/>
            <include name="plugins/maven/lib/*.jar"/>
            <include name="plugins/maven-model/lib/*.jar"/>
            <include name="plugins/maven-server/lib/*.jar"/>
            <include name="plugins/uml/lib/*.jar"/>
            <include name="plugins/copyright/lib/*.jar"/>
        </fileset>
    </path>
