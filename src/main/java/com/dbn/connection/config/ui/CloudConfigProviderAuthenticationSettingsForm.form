<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.connection.config.ui.CloudConfigProviderAuthenticationSettingsForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="6" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="4" left="4" bottom="4" right="4"/>
    <constraints>
      <xy x="20" y="20" width="620" height="190"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="a4af3" class="javax.swing.JLabel" binding="authenticationLabel">
