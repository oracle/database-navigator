<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1"
      bind-to-class="com.dbn.connection.config.configprovider.ui.ConfigProviderExportForm">
  <grid id="root" binding="mainPanel" row-count="6" column-count="2" layout-manager="GridLayoutManager">
    <margin top="16" left="16" bottom="16" right="16"/>
    <constraints>
      <xy x="20" y="20" width="720" height="320"/>
      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3"
            indent="0" use-parent-layout="false"/>
    </constraints>

    <properties/>
    <border type="none"/>

    <children>
      <!-- Optional key label -->
      <component id="lblKey" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0"
                anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Optional key:"/>
        </properties>
      </component>

      <!-- Optional key field -->
      <component id="keyField" class="javax.swing.JTextField" binding="wrapperKeyTextField">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3"
                anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>

      <!-- Save to label -->
      <component id="lblSave" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0"
                anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Save JSON to:"/>
        </properties>
      </component>

      <!-- Save to field with browse button -->
      <component id="outField" class="com.intellij.openapi.ui.TextFieldWithBrowseButton" binding="outputFileTextField">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3"
                anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>

      <!-- Include password checkbox -->
      <component id="cbPwd" class="com.intellij.ui.components.JBCheckBox" binding="includePasswordCheckBox">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3"
                anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Include password — writes sensitive data to disk"/>
        </properties>
      </component>

      <!-- Include wallet checkbox -->
      <component id="cbWallet" class="com.intellij.ui.components.JBCheckBox" binding="includeWalletCheckBox">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3"
                anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Include wallet — writes sensitive data to disk"/>
        </properties>
      </component>

      <!-- Wallet label -->
      <component id="lblWallet" class="javax.swing.JLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0"
                anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Wallet file:"/>
        </properties>
      </component>

      <!-- Wallet file field with browse button -->
      <component id="walletField" class="com.intellij.openapi.ui.TextFieldWithBrowseButton" binding="walletFileTextField">
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3"
                anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>

      <!-- Inline error label (optional) -->
      <component id="err" class="javax.swing.JLabel" binding="errorLabel">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3"
                anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value=""/>
        </properties>
      </component>
    </children>
  </grid>
</form>