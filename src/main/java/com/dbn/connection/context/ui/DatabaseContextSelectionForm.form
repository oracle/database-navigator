<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.connection.context.ui.DatabaseContextSelectionForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="5" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="12" left="12" bottom="12" right="12"/>
    <constraints>
      <xy x="20" y="20" width="520" height="259"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="header" class="com.dbn.common.ui.info.DBNCommentLabel" binding="headerLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <grid id="context" binding="contextPanel" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="4">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="connectionLabel" class="javax.swing.JLabel" binding="connectionLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="90" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <labelFor value="connectionSelector"/>
              <text resource-bundle="messages/DBNResources" key="app.shared.label.Connection"/>
            </properties>
          </component>
          <component id="connectionSelector" class="com.dbn.common.ui.misc.DBNComboBox" binding="connectionSelector">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="180" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <hspacer id="connectionSpacer">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <component id="schemaLabel" class="javax.swing.JLabel" binding="schemaLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <labelFor value="schemaSelector"/>
              <text resource-bundle="messages/DBNResources" key="app.shared.label.Schema"/>
            </properties>
          </component>
          <component id="schemaSelector" class="com.dbn.object.common.ui.DBObjectSelector" binding="schemaSelector">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="sessionLabel" class="javax.swing.JLabel" binding="sessionLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <labelFor value="sessionSelector"/>
              <text resource-bundle="messages/DBNResources" key="app.shared.column.Session"/>
            </properties>
          </component>
          <component id="sessionSelector" class="com.dbn.common.ui.misc.DBNComboBox" binding="sessionSelector">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
        </children>
      </grid>
      <grid id="verification" binding="verificationPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <grid id="actions" binding="actionsPanel" layout-manager="FlowLayout" hgap="0" vgap="0" flow-align="2">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="continue" class="javax.swing.JButton" binding="continueButton" default-binding="true">
            <constraints/>
            <properties>
              <text resource-bundle="messages/DBNResources" key="msg.shared.button.Continue"/>
            </properties>
          </component>
        </children>
      </grid>
      <vspacer id="d2859">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
