<!DOCTYPE data-dictionary [
        <!ELEMENT data-dictionary (statement-execution-processor)*>
        <!ELEMENT statement-execution-processor (statement)*>
        <!ATTLIST statement-execution-processor
                id CDATA #REQUIRED
                is-query CDATA #IMPLIED>
        <!ELEMENT statement (#PCDATA)>
        <!ATTLIST statement
                comment CDATA #IMPLIED
                variants CDATA #IMPLIED>
        ]>
<data-dictionary>
    <statement-execution-processor id="create-view">
        <statement>create view {0} as {1}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="change-view">
        <statement>create or replace {3} view {0}.{1} as {2}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="change-json-view">
        <statement>create or replace {3} json relational duality view {0}.{1} as {2}</statement>
    </statement-execution-processor>


    <statement-execution-processor id="create-object">
        <statement>create {0}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="create-java-class">
        <statement>
            begin
            execute immediate 'create and compile java source named "{0}" as {1}';
            end;
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="update-object">
        <statement>create or replace {0}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="update-java-object">
        <statement>
            begin
                execute immediate 'create or replace java source named {0}.{1} as {2}';
            end;
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="update-java-resource">
        <statement>
            declare
                v_string_content VARCHAR2(32000) := '{2}';
                v_binary_content BLOB;
            begin
                dbms_lob.createtemporary(v_binary_content, TRUE);
                dbms_lob.writeappend(
                        v_binary_content,
                        length(v_string_content),
                        utl_raw.cast_to_raw(v_string_content));

                execute immediate 'CREATE OR REPLACE JAVA RESOURCE NAMED {0}.{1} as :1' using v_binary_content;
                dbms_lob.freetemporary(v_binary_content);
            exception
                when others then
                    if dbms_lob.istemporary(v_binary_content) = 1 then
                        dbms_lob.freetemporary(v_binary_content);
                    end if;
            end;
        </statement>
    </statement-execution-processor>
    
    <statement-execution-processor id="drop-object">
        <statement>drop {0} {1}.{2}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="drop-constraint">
        <statement>alter table {0}.{1} drop constraint {2}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="drop-object-body">
        <statement>drop {0} body {1}.{2}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="drop-java-object">
        <statement>
            begin
                execute immediate 'drop java source {0}.{1}';
            exception
            when others then
                execute immediate 'drop java class {0}.{1}';
            end;
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="compile-object">
        <statement>
            alter {2} {0}.{1} compile {3}
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="compile-object-body">
        <statement>
            alter {2} {0}.{1} compile {3} body
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="compile-java-source">
        <statement>
            alter JAVA SOURCE {0}.{1} compile
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="compile-java-class">
        <statement>
            alter JAVA CLASS {0}.{1} compile
        </statement>
    </statement-execution-processor>

</data-dictionary>