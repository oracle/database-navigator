<!DOCTYPE data-dictionary SYSTEM "../statement-interface.dtd">
<data-dictionary>
    <statement-execution-processor id="create-job" timeout="10">
        <statement>
            BEGIN
                DBMS_SCHEDULER.CREATE_JOB(
                    job_name   => {#0},
                    job_type   => 'PLSQL_BLOCK',
                    job_action => {#1},
                    start_date => SYSTIMESTAMP,
                    enabled    => TRUE,
                    auto_drop  => FALSE);
            END;
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="load-job-snapshot" timeout="5">
        <statement>
            SELECT j.state,
                   r.status AS run_status,
                   TO_CHAR(r.error#) AS error_number,
                   r.additional_info
            FROM USER_SCHEDULER_JOBS j
            OUTER APPLY (
                SELECT status, error#, additional_info
                FROM USER_SCHEDULER_JOB_RUN_DETAILS
                WHERE job_name = j.job_name
                ORDER BY log_date DESC
                FETCH FIRST 1 ROWS ONLY) r
            WHERE j.job_name = UPPER({#0})
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="stop-job" timeout="5">
        <statement>
            BEGIN
                DBMS_SCHEDULER.STOP_JOB(job_name => {#0}, force => TRUE);
            END;
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="drop-job" timeout="5">
        <statement>
            BEGIN
                DBMS_SCHEDULER.DROP_JOB(job_name => {#0}, force => FALSE);
            END;
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="force-drop-job" timeout="5">
        <statement>
            BEGIN
                DBMS_SCHEDULER.DROP_JOB(job_name => {#0}, force => TRUE);
            END;
        </statement>
    </statement-execution-processor>
</data-dictionary>
