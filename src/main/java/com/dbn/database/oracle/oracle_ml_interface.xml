<!DOCTYPE data-dictionary [
        <!ELEMENT data-dictionary (statement-execution-processor)*>
        <!ELEMENT statement-execution-processor (statement)*>
        <!ATTLIST statement-execution-processor
                id CDATA #REQUIRED
                timeout CDATA #IMPLIED>
        <!ELEMENT statement (#PCDATA)>
        <!ATTLIST statement
                comment CDATA #IMPLIED
                prefixes CDATA #IMPLIED>
        ]>
<data-dictionary>

    <!-- ==================== MODEL CREATION ==================== -->

    <statement-execution-processor id="create-ml-model" timeout="300000">
        <statement>
            BEGIN
                DBMS_DATA_MINING.CREATE_MODEL(
                    model_name          => {#0},
                    mining_function     => {#1},
                    data_table_name     => {#2},
                    case_id_column_name => {#3},
                    target_column_name  => {#4},
                    settings_table_name => {#5}
                );
            END;
        </statement>
    </statement-execution-processor>

    <!-- Create Settings Table -->
    <statement-execution-processor id="create-settings-table" timeout="5000">
        <statement>
            CREATE TABLE {0} (
                setting_name  VARCHAR2(30),
                setting_value VARCHAR2(4000)
            )
        </statement>
    </statement-execution-processor>

    <!-- Insert Setting into Settings Table -->
    <statement-execution-processor id="insert-setting" timeout="5000">
        <statement>
            INSERT INTO {0} (setting_name, setting_value)
            VALUES ({#1}, {#2})
        </statement>
    </statement-execution-processor>

    <!-- Drop ML Model -->
    <statement-execution-processor id="drop-ml-model" timeout="30000">
        <statement>
            BEGIN
                DBMS_DATA_MINING.DROP_MODEL({#0});
            END;
        </statement>
    </statement-execution-processor>

    <!-- Rename ML Model -->
    <statement-execution-processor id="rename-ml-model" timeout="30000">
        <statement>
            BEGIN
                DBMS_DATA_MINING.RENAME_MODEL({#0}, {#1});
            END;
        </statement>
    </statement-execution-processor>

    <!-- ==================== DATA SPLITTING ==================== -->

    <!-- Create Training Data Table using SAMPLE with SEED (80% by default) -->
    <!-- Parameters: 0=train_table, 1=source_table, 2=sample_percent, 3=seed -->
    <statement-execution-processor id="create-training-table" timeout="60000">
        <statement>
            CREATE TABLE {0} AS SELECT * FROM {1} SAMPLE ({2}) SEED ({3})
        </statement>
    </statement-execution-processor>

    <!-- Create Test Data Table (remaining data not in training) -->
    <!-- Parameters: 0=test_table, 1=source_table, 2=train_table -->
    <statement-execution-processor id="create-test-table" timeout="60000">
        <statement>
            CREATE TABLE {0} AS SELECT * FROM {1} MINUS SELECT * FROM {2}
        </statement>
    </statement-execution-processor>

    <!-- Add CASE_ID column to a table for evaluation -->
    <!-- Parameters: 0=table_name -->
    <statement-execution-processor id="add-case-id-column" timeout="10000">
        <statement>
            ALTER TABLE {0} ADD (CASE_ID NUMBER GENERATED ALWAYS AS IDENTITY)
        </statement>
    </statement-execution-processor>

    <!-- Get row count from table -->
    <statement-execution-processor id="get-row-count" timeout="10000">
        <statement>
            SELECT COUNT(*) AS ROW_COUNT FROM {0}
        </statement>
    </statement-execution-processor>

    <!-- ==================== APPLY MODEL (Create Predictions) ==================== -->

    <!-- Create Apply Results table using PREDICTION and PREDICTION_PROBABILITY -->
    <!-- Parameters: 0=apply_result_table, 1=model_name, 2=test_table -->
    <statement-execution-processor id="create-apply-results" timeout="120000">
        <statement>
            CREATE TABLE {0} AS
            SELECT
                CASE_ID,
                PREDICTION({1} USING *) AS PREDICTION,
                PREDICTION_PROBABILITY({1} USING *) AS PROBABILITY
            FROM {2}
        </statement>
    </statement-execution-processor>

    <!-- Create Apply Results for Regression (no probability) -->
    <!-- Parameters: 0=apply_result_table, 1=model_name, 2=test_table -->
    <statement-execution-processor id="create-apply-results-regression" timeout="120000">
        <statement>
            CREATE TABLE {0} AS
            SELECT
                CASE_ID,
                PREDICTION({1} USING *) AS PREDICTION
            FROM {2}
        </statement>
    </statement-execution-processor>

    <!-- Ad-hoc prediction (regression or classification without probability) -->
    <!-- Parameters: 0=model_name, 1=feature_clause (e.g., "1.5 AS col1, 'A' AS col2") -->
    <statement-execution-processor id="predict-adhoc" timeout="30000">
        <statement>
            SELECT PREDICTION({0} USING *) AS PREDICTION FROM (SELECT {1} FROM DUAL)
        </statement>
    </statement-execution-processor>

    <!-- Ad-hoc prediction with probability (classification only) -->
    <!-- Parameters: 0=model_name, 1=feature_clause -->
    <statement-execution-processor id="predict-adhoc-with-probability" timeout="30000">
        <statement>
            SELECT
                PREDICTION({0} USING *) AS PREDICTION,
                PREDICTION_PROBABILITY({0} USING *) AS PROBABILITY
            FROM (SELECT {1} FROM DUAL)
        </statement>
    </statement-execution-processor>

    <!-- ==================== EVALUATION PROCEDURES ==================== -->

    <!-- Compute Confusion Matrix using DBMS_DATA_MINING.COMPUTE_CONFUSION_MATRIX -->
    <!-- Parameters: 0=apply_result_table, 1=target_table, 2=target_column, 3=confusion_matrix_table -->
    <!-- Returns: accuracy as OUT parameter -->
    <statement-execution-processor id="compute-confusion-matrix" timeout="120000">
        <statement>
            DECLARE
                v_accuracy NUMBER;
            BEGIN
                DBMS_DATA_MINING.COMPUTE_CONFUSION_MATRIX(
                    accuracy                    => v_accuracy,
                    apply_result_table_name     => {#0},
                    target_table_name           => {#1},
                    case_id_column_name         => 'CASE_ID',
                    target_column_name          => {#2},
                    confusion_matrix_table_name => {#3},
                    score_column_name           => 'PREDICTION',
                    score_criterion_column_name => 'PROBABILITY',
                    cost_matrix_table_name      => NULL,
                    apply_result_schema_name    => NULL,
                    target_schema_name          => NULL,
                    cost_matrix_schema_name     => NULL,
                    score_criterion_type        => 'PROBABILITY'
                );
                -- Store accuracy in a temp table so we can retrieve it
                EXECUTE IMMEDIATE 'CREATE TABLE {3}_ACC (ACCURACY NUMBER)';
                EXECUTE IMMEDIATE 'INSERT INTO {3}_ACC VALUES (' || v_accuracy || ')';
            END;
        </statement>
    </statement-execution-processor>

    <!-- Get accuracy from temp table created by compute-confusion-matrix -->
    <statement-execution-processor id="get-accuracy" timeout="5000">
        <statement>
            SELECT ACCURACY FROM {0}_ACC
        </statement>
    </statement-execution-processor>

    <!-- Get confusion matrix results -->
    <statement-execution-processor id="get-confusion-matrix-results" timeout="10000">
        <statement>
            SELECT ACTUAL_TARGET_VALUE, PREDICTED_TARGET_VALUE, VALUE
            FROM {0}
            ORDER BY ACTUAL_TARGET_VALUE, PREDICTED_TARGET_VALUE
        </statement>
    </statement-execution-processor>

    <!-- Compute ROC (for binary classification) -->
    <!-- Parameters: 0=apply_result_table, 1=target_table, 2=target_column, 3=roc_table, 4=positive_target_value -->
    <statement-execution-processor id="compute-roc" timeout="120000">
        <statement>
            DECLARE
                v_auc NUMBER;
            BEGIN
                DBMS_DATA_MINING.COMPUTE_ROC(
                    roc_area_under_curve        => v_auc,
                    apply_result_table_name     => {#0},
                    target_table_name           => {#1},
                    case_id_column_name         => 'CASE_ID',
                    target_column_name          => {#2},
                    roc_table_name              => {#3},
                    positive_target_value       => {#4},
                    score_column_name           => 'PREDICTION',
                    score_criterion_column_name => 'PROBABILITY',
                    apply_result_schema_name    => NULL,
                    target_schema_name          => NULL
                );
                -- Store AUC in a temp table
                EXECUTE IMMEDIATE 'CREATE TABLE {3}_AUC (AUC NUMBER)';
                EXECUTE IMMEDIATE 'INSERT INTO {3}_AUC VALUES (' || v_auc || ')';
            END;
        </statement>
    </statement-execution-processor>

    <!-- Get AUC from temp table -->
    <statement-execution-processor id="get-auc" timeout="5000">
        <statement>
            SELECT AUC FROM {0}_AUC
        </statement>
    </statement-execution-processor>

    <!-- Compute Lift (for binary classification) -->
    <!-- Parameters: 0=apply_result_table, 1=target_table, 2=target_column, 3=lift_table, 4=positive_target_value -->
    <statement-execution-processor id="compute-lift" timeout="120000">
        <statement>
            BEGIN
                DBMS_DATA_MINING.COMPUTE_LIFT(
                    apply_result_table_name     => {#0},
                    target_table_name           => {#1},
                    case_id_column_name         => 'CASE_ID',
                    target_column_name          => {#2},
                    lift_table_name             => {#3},
                    positive_target_value       => {#4},
                    score_column_name           => 'PREDICTION',
                    score_criterion_column_name => 'PROBABILITY',
                    num_quantiles               => 10,
                    cost_matrix_table_name      => NULL,
                    apply_result_schema_name    => NULL,
                    target_schema_name          => NULL,
                    cost_matrix_schema_name     => NULL,
                    score_criterion_type        => 'PROBABILITY'
                );
            END;
        </statement>
    </statement-execution-processor>

    <!-- Get Lift results -->
    <statement-execution-processor id="get-lift-results" timeout="10000">
        <statement>
            SELECT QUANTILE_NUMBER, PROBABILITY_THRESHOLD, GAIN_CUMULATIVE, LIFT_CUMULATIVE,
                   TARGETS_CUMULATIVE, NON_TARGETS_CUMULATIVE
            FROM {0}
            ORDER BY QUANTILE_NUMBER
        </statement>
    </statement-execution-processor>

    <!-- ==================== REGRESSION EVALUATION ==================== -->

    <!-- Get Regression Metrics by comparing predictions to actuals on TEST data -->
    <!-- Parameters: 0=model_name, 1=target_column, 2=test_table -->
    <statement-execution-processor id="get-regression-metrics" timeout="30000">
        <statement>
            SELECT
                COUNT(*) as sample_count,
                ROUND(1 - (SUM(POWER(actual - predicted, 2)) / NULLIF(SUM(POWER(actual - avg_actual, 2)), 0)), 4) as r_squared,
                ROUND(SQRT(AVG(POWER(actual - predicted, 2))), 4) as rmse,
                ROUND(AVG(ABS(actual - predicted)), 4) as mae
            FROM (
                SELECT
                    PREDICTION({0} USING *) as predicted,
                    {1} as actual,
                    AVG({1}) OVER () as avg_actual
                FROM {2}
            )
        </statement>
    </statement-execution-processor>

    <!-- ==================== LEGACY EVALUATION (for backward compatibility) ==================== -->

    <!-- Get Classification Accuracy (legacy - evaluates on provided table) -->
    <statement-execution-processor id="get-classification-accuracy" timeout="30000">
        <statement>
            SELECT
                COUNT(*) as total_count,
                SUM(CASE WHEN predicted = actual THEN 1 ELSE 0 END) as correct_count,
                ROUND(SUM(CASE WHEN predicted = actual THEN 1 ELSE 0 END) / COUNT(*) * 100, 2) as accuracy_pct
            FROM (
                SELECT
                    PREDICTION({0} USING *) as predicted,
                    {1} as actual
                FROM {2}
            )
        </statement>
    </statement-execution-processor>

    <!-- Get Confusion Matrix (legacy - evaluates on provided table) -->
    <statement-execution-processor id="get-confusion-matrix" timeout="30000">
        <statement>
            SELECT
                actual as actual_target_value,
                predicted as predicted_target_value,
                COUNT(*) as value
            FROM (
                SELECT
                    PREDICTION({0} USING *) as predicted,
                    {1} as actual
                FROM {2}
            )
            GROUP BY actual, predicted
            ORDER BY actual, predicted
        </statement>
    </statement-execution-processor>

    <!-- Read CSV header line from cloud object storage using DBMS_CLOUD.GET_OBJECT -->
    <!-- Returns a single row with HEADER_LINE containing the first line of the CSV file -->
    <!-- Parameters: 0=credential_name, 1=file_uri -->
    <statement-execution-processor id="get-cloud-csv-header" timeout="30000">
        <statement>
            SELECT UTL_RAW.CAST_TO_VARCHAR2(
                       DBMS_LOB.SUBSTR(
                           DBMS_CLOUD.GET_OBJECT(
                               credential_name => {#0},
                               object_uri      => {#1}
                           ),
                           4000,
                           1
                       )
                   ) AS FILE_HEAD
            FROM DUAL
        </statement>
    </statement-execution-processor>

    <!-- ==================== MODEL DETAIL VIEWS ==================== -->

    <!-- Query Global Statistics view (DM$VG) for a model -->
    <!-- Parameters: 0=model_name -->
    <statement-execution-processor id="get-model-global-stats" timeout="10000">
        <statement>
            SELECT NAME, NUMERIC_VALUE, STRING_VALUE
            FROM DM$VG{0}
            ORDER BY NAME
        </statement>
    </statement-execution-processor>

    <!-- Query Attribute Details view (DM$VA) for a model -->
    <!-- Parameters: 0=model_name -->
    <statement-execution-processor id="get-model-attribute-details" timeout="10000">
        <statement>
            SELECT *
            FROM DM$VA{0}
        </statement>
    </statement-execution-processor>

    <!-- Query variable importance from DM$VA (Random Forest, EM, MDL algorithms) -->
    <!-- Parameters: 0=model_name -->
    <statement-execution-processor id="get-model-variable-importance" timeout="10000">
        <statement>
            SELECT ATTRIBUTE_NAME, ATTRIBUTE_IMPORTANCE
            FROM DM$VA{0}
            ORDER BY ATTRIBUTE_IMPORTANCE DESC NULLS LAST
        </statement>
    </statement-execution-processor>

    <!-- Query Computed Settings view (DM$VS) for a model -->
    <!-- Parameters: 0=model_name -->
    <statement-execution-processor id="get-model-computed-settings" timeout="10000">
        <statement>
            SELECT SETTING_NAME, SETTING_VALUE
            FROM DM$VS{0}
            ORDER BY SETTING_NAME
        </statement>
    </statement-execution-processor>

    <!-- Query Build Alerts view (DM$VW) for a model — all algorithms -->
    <!-- Parameters: 0=model_name -->
    <statement-execution-processor id="get-model-alerts" timeout="10000">
        <statement>
            SELECT ERROR_NUMBER, ERROR_TEXT FROM DM$VW{0} ORDER BY ERROR_NUMBER
        </statement>
    </statement-execution-processor>

    <!-- Query GLM Coefficients view (DM$VD) — Logistic Regression, Linear Regression -->
    <!-- Parameters: 0=model_name -->
    <statement-execution-processor id="get-model-glm-coefficients" timeout="10000">
        <statement>
            SELECT ATTRIBUTE_NAME, ATTRIBUTE_VALUE, COEFFICIENT, STD_ERROR, TEST_STATISTIC, P_VALUE, VIF
            FROM DM$VD{0}
            ORDER BY ABS(COEFFICIENT) DESC NULLS LAST
        </statement>
    </statement-execution-processor>

    <!-- Query SVM Linear Coefficients view (DM$VL) — SVM Classification, SVM Regression -->
    <!-- Parameters: 0=model_name -->
    <statement-execution-processor id="get-model-svm-coefficients" timeout="10000">
        <statement>
            SELECT ATTRIBUTE_NAME, ATTRIBUTE_VALUE, CLASS, COEFFICIENT
            FROM DM$VL{0}
            ORDER BY CLASS, ABS(COEFFICIENT) DESC NULLS LAST
        </statement>
    </statement-execution-processor>

    <!-- Query Decision Tree Splits view (DM$VP) — Decision Tree only -->
    <!-- Parameters: 0=model_name -->
    <statement-execution-processor id="get-model-tree-splits" timeout="10000">
        <statement>
            SELECT NODE, PARENT, ATTRIBUTE_NAME, OPERATOR, VALUE
            FROM DM$VP{0}
            WHERE SPLIT_TYPE = 'MAIN'
            ORDER BY NODE
        </statement>
    </statement-execution-processor>

    <!-- Query Naive Bayes class priors (DM$VP) — Naive Bayes only -->
    <!-- Parameters: 0=model_name -->
    <statement-execution-processor id="get-model-nb-priors" timeout="10000">
        <statement>
            SELECT TARGET_VALUE, PRIOR_PROBABILITY, COUNT
            FROM DM$VP{0}
            ORDER BY PRIOR_PROBABILITY DESC
        </statement>
    </statement-execution-processor>

    <!-- Query Naive Bayes top conditional probabilities (DM$VV) — Naive Bayes only -->
    <!-- Parameters: 0=model_name -->
    <statement-execution-processor id="get-model-nb-conditionals" timeout="10000">
        <statement>
            SELECT TARGET_VALUE, ATTRIBUTE_NAME, ATTRIBUTE_VALUE, CONDITIONAL_PROBABILITY
            FROM DM$VV{0}
            ORDER BY CONDITIONAL_PROBABILITY DESC
            FETCH FIRST 50 ROWS ONLY
        </statement>
    </statement-execution-processor>

    <!-- ==================== CLOUD OBJECT STORAGE ==================== -->

    <!-- Create External Table over Cloud Object Storage using DBMS_CLOUD -->
    <!-- Parameters: 0=table_name, 1=credential_name, 2=file_uri, 3=delimiter, 4=skip_headers, 5=column_list -->
    <statement-execution-processor id="create-cloud-external-table" timeout="120000">
        <statement>
            BEGIN
                DBMS_CLOUD.CREATE_EXTERNAL_TABLE(
                    table_name      => {#0},
                    credential_name => {#1},
                    file_uri_list   => {#2},
                    format          => JSON_OBJECT('type' VALUE 'csv', 'delimiter' VALUE {#3}, 'skipheaders' VALUE {#4}),
                    column_list     => {#5}
                );
            END;
        </statement>
    </statement-execution-processor>

    <!-- ==================== UTILITY OPERATIONS ==================== -->

    <!-- Create Staging Table -->
    <statement-execution-processor id="create-staging-table" timeout="10000">
        <statement>
            CREATE TABLE {0} (
                {1}
            )
        </statement>
    </statement-execution-processor>

    <!-- Drop Staging Table -->
    <statement-execution-processor id="drop-staging-table" timeout="10000">
        <statement>
            DROP TABLE {0} PURGE
        </statement>
    </statement-execution-processor>

    <!-- Drop Table (generic) -->
    <statement-execution-processor id="drop-table" timeout="10000">
        <statement>
            DROP TABLE {0} PURGE
        </statement>
    </statement-execution-processor>

    <!-- Check if Table Exists -->
    <statement-execution-processor id="check-table-exists" timeout="5000">
        <statement>
            SELECT COUNT(*)
            FROM ALL_TABLES
            WHERE owner = NVL({#0}, USER)
              AND table_name = {#1}
        </statement>
    </statement-execution-processor>

    <!-- Get distinct class count for classification -->
    <statement-execution-processor id="get-distinct-class-count" timeout="10000">
        <statement>
            SELECT COUNT(DISTINCT {0}) AS CLASS_COUNT FROM {1}
        </statement>
    </statement-execution-processor>

    <!-- Get class values for binary classification check -->
    <statement-execution-processor id="get-class-values" timeout="10000">
        <statement>
            SELECT DISTINCT {0} AS CLASS_VALUE FROM {1} ORDER BY {0}
        </statement>
    </statement-execution-processor>

    <!-- Get existing model names from USER_MINING_MODELS -->
    <statement-execution-processor id="get-existing-model-names" timeout="10000">
        <statement>
            SELECT MODEL_NAME FROM USER_MINING_MODELS
        </statement>
    </statement-execution-processor>

</data-dictionary>
