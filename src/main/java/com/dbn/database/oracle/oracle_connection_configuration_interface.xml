<!DOCTYPE data-dictionary [
        <!ELEMENT data-dictionary (statement-execution-processor)*>
        <!ELEMENT statement-execution-processor (statement)*>
        <!ATTLIST statement-execution-processor
                id CDATA #REQUIRED
                timeout CDATA #IMPLIED>
        <!ELEMENT statement (#PCDATA)>
        <!ATTLIST statement
                comment CDATA #IMPLIED
                prefixes CDATA #IMPLIED>
        ]>
<data-dictionary>
    <statement-execution-processor id="connection-configuration">
        <statement prefixes="DBA, ALL">
            select
                json_serialize(value returning clob pretty) as value
            from [PREFIX]_DATA_SOURCE_CONFIGS
            where upper(owner) = upper({#0})
              and upper(config_name) = upper({#1})
        </statement>
        <statement prefixes="USER">
            select
                json_serialize(value returning clob pretty) as value
            from USER_DATA_SOURCE_CONFIGS
            where upper(config_name) = upper({#1})
        </statement>
        <statement>
            <!--empty fallback for databases without data source config store-->
            select
                null as value
            from dual
            where 1 = 0
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="create-connection-configuration">
        <statement>
            begin SYS.DBMS_DATA_SOURCE_CONFIG.CREATE_CONFIG(
                p_config_name => {#0},
                p_value => JSON({#1})); end;
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="update-connection-configuration">
        <statement>
            begin SYS.DBMS_DATA_SOURCE_CONFIG.ALTER_CONFIG(
                p_config_name => {#0},
                p_value => JSON({#1})); end;
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="delete-connection-configuration">
        <statement>
            begin SYS.DBMS_DATA_SOURCE_CONFIG.DROP_CONFIG(
                p_config_name => {#0}); end;
        </statement>
    </statement-execution-processor>
</data-dictionary>
