<!DOCTYPE data-dictionary [
        <!ELEMENT data-dictionary (statement-execution-processor)*>
        <!ELEMENT statement-execution-processor (statement)*>
        <!ATTLIST statement-execution-processor
                id CDATA #REQUIRED
                timeout CDATA #IMPLIED>
        <!ELEMENT statement (#PCDATA)>
        <!ATTLIST statement
                comment CDATA #IMPLIED
                prefixes CDATA #IMPLIED>
        ]>
<data-dictionary>
    <statement-execution-processor id="data-source-config-entry">
        <statement>
            select
                config_name as key,
                json_serialize(value returning clob pretty) as value,
                to_char(last_updated, 'YYYY-MM-DD HH24:MI:SS.FF3 TZH:TZM') as last_updated
            from user_data_source_configs
            where upper(config_name) = upper({#0})
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="insert-data-source-config-entry">
        <statement>
            begin SYS.DBMS_DATA_SOURCE_CONFIG.CREATE_CONFIG(
                p_config_name => {#0},
                p_value => JSON({#1})); end;
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="update-data-source-config-entry">
        <statement>
            begin SYS.DBMS_DATA_SOURCE_CONFIG.ALTER_CONFIG(
                p_config_name => {#0},
                p_value => JSON({#1})); end;
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="delete-data-source-config-entry">
        <statement>
            begin SYS.DBMS_DATA_SOURCE_CONFIG.DROP_CONFIG(
                p_config_name => {#0}); end;
        </statement>
    </statement-execution-processor>
</data-dictionary>
