<!DOCTYPE data-dictionary SYSTEM "../statement-interface.dtd">
<data-dictionary>
    <statement-execution-processor id="create-view" transactional="true">
        <statement>create view {0} as {1}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="change-view" transactional="true">
        <statement>create or replace view {0}.{1} as {2}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="refresh-materialized-view" transactional="true">
        <statement>refresh materialized view {@0}.{@1}</statement>
    </statement-execution-processor>


    <statement-execution-processor id="create-object" transactional="true">
        <statement>create {0}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="create-trigger-function" transactional="true">
        <statement>
            create function {0}() returns trigger language plpgsql as $DBN_TRIGGER$
            {1}
            $DBN_TRIGGER$
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="create-event-trigger-function" transactional="true">
        <statement>
            create function {0}() returns event_trigger language plpgsql as $DBN_EVENT_TRIGGER$
            {1}
            $DBN_EVENT_TRIGGER$
        </statement>
    </statement-execution-processor>

    <statement-execution-processor id="update-object" transactional="true">
        <statement>create or replace {0}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="drop-object" transactional="true">
        <statement>drop {0} {1}.{2}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="drop-user">
        <statement>drop user {@0}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="enable-user">
        <statement>alter role {@0} login</statement>
    </statement-execution-processor>

    <statement-execution-processor id="disable-user">
        <statement>alter role {@0} nologin</statement>
    </statement-execution-processor>

    <statement-execution-processor id="drop-constraint">
        <statement>alter table {0}.{1} drop constraint {2}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="drop-trigger">
        <statement>drop trigger {@2} on {@0}.{@1}</statement>
    </statement-execution-processor>

    <statement-execution-processor id="drop-trigger-function" transactional="true">
        <statement>drop function if exists {0}()</statement>
    </statement-execution-processor>

    <statement-execution-processor id="drop-event-trigger-function" transactional="true">
        <statement>drop function if exists {0}()</statement>
    </statement-execution-processor>

    <statement-execution-processor id="get-session-sql-mode">
        <statement>SELECT @@session.sql_mode</statement>
    </statement-execution-processor>

    <statement-execution-processor id="set-session-sql-mode">
        <statement>SET sql_mode='{0}'</statement>
    </statement-execution-processor>
</data-dictionary>
