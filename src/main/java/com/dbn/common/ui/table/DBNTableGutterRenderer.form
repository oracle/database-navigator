<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.common.ui.table.DBNTableGutterRenderer">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="93" height="25"/>
    </constraints>
    <properties/>
    <border type="empty">
      <size top="0" left="4" bottom="0" right="4"/>
    </border>
    <children>
      <component id="13d49" class="javax.swing.JLabel" binding="textLabel">
        <constraints border-constraint="Center"/>
        <properties>
          <horizontalAlignment value="11"/>
          <horizontalTextPosition value="2"/>
          <text resource-bundle="messages/DBNResources" key="app.shared.placeholder.Text"/>
        </properties>
      </component>
      <component id="d8aea" class="javax.swing.JLabel" binding="iconLabel">
        <constraints border-constraint="East"/>
        <properties>
          <text resource-bundle="messages/DBNResources" key="app.shared.placeholder.Icon"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
