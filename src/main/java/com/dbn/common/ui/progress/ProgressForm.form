<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.common.ui.progress.ProgressForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="4">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="74"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="32978" class="javax.swing.JLabel" binding="progressTextLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="[progress text]"/>
        </properties>
      </component>
      <component id="85e7b" class="javax.swing.JProgressBar" binding="progressBar">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="1" fill="1" indent="0" use-parent-layout="false">
            <minimum-size width="400" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="cbeb6" class="javax.swing.JLabel" binding="progressText2Label">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="[progress details]"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
