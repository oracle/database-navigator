<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.browser.options.ui.DatabaseBrowserEditorSettingsForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="8" left="8" bottom="8" right="8"/>
    <constraints>
      <xy x="20" y="20" width="510" height="235"/>
    </constraints>
    <properties/>
    <border type="none" title-resource-bundle="messages/DBNResources" title-key="cfg.browser.title.DefaultEditors"/>
    <children>
      <scrollpane id="ac9bc" class="com.intellij.ui.components.JBScrollPane" binding="editorTypesScrollPanel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="1" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="150"/>
            <maximum-size width="-1" height="150"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </scrollpane>
      <vspacer id="458a1">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
