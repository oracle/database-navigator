<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.mcp.ui.ToolDefinitionCreateForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="8" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="600" height="500"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="375ff" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="748fb"/>
          <text value="Tool name:"/>
        </properties>
      </component>
      <component id="748fb" class="javax.swing.JTextField" binding="toolName">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="fe984" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Description:"/>
        </properties>
      </component>
      <scrollpane id="desc01">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="60"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="650cf" class="com.intellij.ui.components.JBTextArea" binding="toolDescriptionTextArea">
            <constraints/>
            <properties>
              <lineWrap value="true"/>
              <wrapStyleWord value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <grid id="669aa" binding="sqlEditorPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <minimum-size width="-1" height="180"/>
            <preferred-size width="-1" height="220"/>
          </grid>
        </constraints>
        <properties/>
        <border type="line" title="SQL Query (use :param placeholders)"/>
        <children/>
      </grid>
      <grid id="verify01" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="verify02" class="javax.swing.JButton" binding="testSqlButton">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Test SQL Query..."/>
            </properties>
          </component>
          <component id="verify05" class="javax.swing.JLabel" binding="sqlTestStatusLabel">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <foreground color="-6645094"/>
              <text value="Not tested yet. Open tester to verify SQL and preview results."/>
            </properties>
          </component>
          <hspacer id="verify04">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
        </children>
      </grid>
      <component id="dd656" class="javax.swing.JLabel">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Parameters (schema):"/>
        </properties>
      </component>
      <scrollpane id="params01" binding="paramsScrollPane">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <minimum-size width="-1" height="170"/>
            <preferred-size width="-1" height="260"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="params02" class="com.intellij.ui.table.JBTable" binding="paramsTable">
            <constraints/>
            <properties>
              <fillsViewportHeight value="true"/>
              <rowHeight value="24"/>
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
