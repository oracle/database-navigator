<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.mcp.ui.McpServerDetailsForm">
  <grid id="main" binding="mainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="720" height="520"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="header" binding="headerPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <scrollpane id="scroll" class="com.dbn.common.ui.misc.DBNScrollPane">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="content" binding="contentPanel" layout-manager="GridLayoutManager" row-count="8" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="4">
            <margin top="10" left="12" bottom="12" right="12"/>
            <constraints/>
            <properties/>
            <border type="none"/>
            <children>
              <component id="subtitle" class="javax.swing.JLabel" binding="subtitleLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[subtitle]"/>
                </properties>
              </component>
              <component id="description" class="javax.swing.JLabel" binding="descriptionLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[description]"/>
                </properties>
              </component>
              <grid id="hints" binding="hintsPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children/>
              </grid>
              <component id="image-label" class="javax.swing.JLabel" binding="imageLabel">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[image]"/>
                </properties>
              </component>
              <component id="image-value" class="javax.swing.JLabel" binding="imageValueLabel">
                <constraints>
                  <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value=""/>
                </properties>
              </component>
              <component id="image-copy" class="javax.swing.JButton" binding="imageCopyButton">
                <constraints>
                  <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value=""/>
                </properties>
              </component>
              <component id="endpoint-label" class="javax.swing.JLabel" binding="endpointLabel">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[endpoint]"/>
                </properties>
              </component>
              <component id="endpoint-link" class="com.intellij.ui.HyperlinkLabel" binding="endpointLink">
                <constraints>
                  <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <component id="endpoint-copy" class="javax.swing.JButton" binding="endpointCopyButton">
                <constraints>
                  <grid row="4" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value=""/>
                </properties>
              </component>
              <component id="folder-label" class="javax.swing.JLabel" binding="folderLabel">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[folder]"/>
                </properties>
              </component>
              <component id="folder-value" class="javax.swing.JLabel" binding="folderValueLabel">
                <constraints>
                  <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value=""/>
                </properties>
              </component>
              <component id="folder-reveal" class="javax.swing.JButton" binding="revealButton">
                <constraints>
                  <grid row="5" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value=""/>
                </properties>
              </component>
              <hspacer id="value-spacer">
                <constraints>
                  <grid row="3" column="3" row-span="3" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
              </hspacer>
              <component id="readme" class="com.intellij.ui.HyperlinkLabel" binding="readmeLink">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <grid id="snippets" binding="snippetsPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
                <constraints>
                  <grid row="7" column="0" row-span="1" col-span="4" vsize-policy="7" hsize-policy="6" anchor="1" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children/>
              </grid>
            </children>
          </grid>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
