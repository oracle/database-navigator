<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.mcp.ui.McpServerDetailsForm">
  <grid id="main" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="2">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="720" height="520"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="header" binding="headerPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <component id="subtitle" class="javax.swing.JLabel" binding="subtitleLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <border type="empty">
            <size top="4" left="12" bottom="6" right="12"/>
          </border>
          <text value="[subtitle]"/>
        </properties>
      </component>
      <tabbedpane id="tabs" binding="tabbedPane">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="overview" binding="overviewPanel" layout-manager="GridLayoutManager" row-count="11" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="5">
            <margin top="10" left="12" bottom="10" right="12"/>
            <constraints>
              <tabbedpane title-resource-bundle="messages/DBNResources" title-key="app.mcp.title.Overview"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <grid id="hints" binding="hintsPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
                <constraints>
                  <grid row="8" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children/>
              </grid>
              <component id="description" class="javax.swing.JLabel" binding="descriptionLabel">
                <constraints>
                  <grid row="9" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[description]"/>
                </properties>
              </component>
              <component id="status-label" class="javax.swing.JLabel" binding="statusLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[status]"/>
                </properties>
              </component>
              <component id="status-value" class="javax.swing.JLabel" binding="statusValueLabel">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties><text value=""/></properties>
              </component>
              <component id="impl-label" class="javax.swing.JLabel" binding="implLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[impl]"/>
                </properties>
              </component>
              <component id="impl-value" class="javax.swing.JLabel" binding="implValueLabel">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties><text value=""/></properties>
              </component>
              <component id="transport-label" class="javax.swing.JLabel" binding="transportLabel">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[transport]"/>
                </properties>
              </component>
              <component id="transport-value" class="javax.swing.JLabel" binding="transportValueLabel">
                <constraints>
                  <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties><text value=""/></properties>
              </component>
              <component id="image-label" class="javax.swing.JLabel" binding="imageLabel">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[image]"/>
                </properties>
              </component>
              <component id="image-value" class="javax.swing.JLabel" binding="imageValueLabel">
                <constraints>
                  <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties><text value=""/></properties>
              </component>
              <component id="image-action" class="javax.swing.JButton" binding="imageCopyButton">
                <constraints>
                  <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value=""/>
                </properties>
              </component>
              <component id="endpoint-label" class="javax.swing.JLabel" binding="endpointLabel">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[endpoint]"/>
                </properties>
              </component>
              <component id="endpoint-value" class="com.intellij.ui.HyperlinkLabel" binding="endpointLink">
                <constraints>
                  <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties></properties>
              </component>
              <component id="endpoint-action" class="javax.swing.JButton" binding="endpointCopyButton">
                <constraints>
                  <grid row="4" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value=""/>
                </properties>
              </component>
              <component id="folder-label" class="javax.swing.JLabel" binding="folderLabel">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[folder]"/>
                </properties>
              </component>
              <component id="folder-value" class="javax.swing.JLabel" binding="folderValueLabel">
                <constraints>
                  <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties><text value=""/></properties>
              </component>
              <component id="folder-action" class="javax.swing.JButton" binding="revealButton">
                <constraints>
                  <grid row="5" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value=""/>
                </properties>
              </component>
              <component id="built-label" class="javax.swing.JLabel" binding="builtLabel">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[built]"/>
                </properties>
              </component>
              <component id="built-value" class="javax.swing.JLabel" binding="builtValueLabel">
                <constraints>
                  <grid row="6" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties><text value=""/></properties>
              </component>
              <component id="doc-label" class="javax.swing.JLabel" binding="documentationLabel">
                <constraints>
                  <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[doc]"/>
                </properties>
              </component>
              <component id="doc-value" class="com.intellij.ui.HyperlinkLabel" binding="readmeLink">
                <constraints>
                  <grid row="7" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties></properties>
              </component>
              <hspacer id="overview-hspacer">
                <constraints>
                  <grid row="0" column="3" row-span="8" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
              </hspacer>
              <vspacer id="overview-vspacer">
                <constraints>
                  <grid row="10" column="0" row-span="1" col-span="4" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
                </constraints>
              </vspacer>
            </children>
          </grid>
          <grid id="client" binding="clientPanel" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="6">
            <margin top="10" left="12" bottom="10" right="12"/>
            <constraints>
              <tabbedpane title-resource-bundle="messages/DBNResources" title-key="app.mcp.title.ClientSetup"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="client-label" class="javax.swing.JLabel" binding="clientLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="[client]"/>
                </properties>
              </component>
              <component id="client-combo" class="javax.swing.JComboBox" binding="clientComboBox">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="200" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="client-copy" class="javax.swing.JButton" binding="clientCopyButton">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value=""/>
                </properties>
              </component>
              <hspacer id="client-hspacer">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
              </hspacer>
              <scrollpane id="client-scroll" class="com.dbn.common.ui.misc.DBNScrollPane">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="4" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="560" height="200"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="client-text" class="com.intellij.ui.components.JBTextArea" binding="clientTextArea">
                    <constraints/>
                    <properties>
                      <editable value="false"/>
                      <lineWrap value="false"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
        </children>
      </tabbedpane>
    </children>
  </grid>
</form>
