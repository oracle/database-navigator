<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.mcp.ui.McpServerOverviewForm">
<grid id="overview" binding="mainPanel" layout-manager="GridLayoutManager" row-count="7" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="16" vgap="8">
          <margin top="16" left="16" bottom="16" right="16"/>
  <constraints>
    <xy x="20" y="20" width="640" height="400"/>
  </constraints>
          <properties/>
          <border type="none"/>
          <children>
            <component id="status-label" class="javax.swing.JLabel" binding="statusLabel">
              <constraints>
                <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                  <preferred-size width="140" height="-1"/>
                </grid>
              </constraints>
              <properties>
                <text value="[status]"/>
              </properties>
            </component>
            <component id="status-value" class="javax.swing.JLabel" binding="statusValueLabel">
              <constraints>
                <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              </constraints>
              <properties>
                <text value=""/>
              </properties>
            </component>

            <component id="image-label" class="javax.swing.JLabel" binding="imageLabel">
              <constraints>
                <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              </constraints>
              <properties>
                <text value="[image]"/>
              </properties>
            </component>
            <grid id="image-row" binding="imageRowPanel" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="6" vgap="-1">
              <margin top="0" left="0" bottom="0" right="0"/>
              <constraints>
                <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
              </constraints>
              <properties/>
              <border type="none"/>
              <children>
                <component id="image-value" class="javax.swing.JLabel" binding="imageValueLabel">
                  <constraints>
                    <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                  </constraints>
                  <properties>
                    <text value=""/>
                  </properties>
                </component>
                <component id="image-copy" class="javax.swing.JButton" binding="imageCopyButton">
                  <constraints>
                    <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                  </constraints>
                  <properties>
                    <text value=""/>
                  </properties>
                </component>
                <hspacer id="image-spacer">
                  <constraints>
                    <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  </constraints>
                </hspacer>
              </children>
            </grid>

            <component id="endpoint-label" class="javax.swing.JLabel" binding="endpointLabel">
              <constraints>
                <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              </constraints>
              <properties>
                <text value="[endpoint]"/>
              </properties>
            </component>
            <grid id="endpoint-row" binding="endpointRowPanel" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="6" vgap="-1">
              <margin top="0" left="0" bottom="0" right="0"/>
              <constraints>
                <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
              </constraints>
              <properties/>
              <border type="none"/>
              <children>
                <component id="endpoint-value" class="com.intellij.ui.HyperlinkLabel" binding="endpointLink">
                  <constraints>
                    <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                  </constraints>
                  <properties/>
                </component>
                <component id="endpoint-copy" class="javax.swing.JButton" binding="endpointCopyButton">
                  <constraints>
                    <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                  </constraints>
                  <properties>
                    <text value=""/>
                  </properties>
                </component>
                <hspacer id="endpoint-spacer">
                  <constraints>
                    <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  </constraints>
                </hspacer>
              </children>
            </grid>

            <component id="folder-label" class="javax.swing.JLabel" binding="folderLabel">
              <constraints>
                <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              </constraints>
              <properties>
                <text value="[folder]"/>
              </properties>
            </component>
            <grid id="folder-row" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="6" vgap="-1">
              <margin top="0" left="0" bottom="0" right="0"/>
              <constraints>
                <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
              </constraints>
              <properties/>
              <border type="none"/>
              <children>
                <component id="folder-value" class="javax.swing.JLabel" binding="folderValueLabel">
                  <constraints>
                    <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                  </constraints>
                  <properties>
                    <text value=""/>
                  </properties>
                </component>
                <component id="folder-reveal" class="javax.swing.JButton" binding="revealButton">
                  <constraints>
                    <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                  </constraints>
                  <properties>
                    <text value=""/>
                  </properties>
                </component>
                <hspacer id="folder-spacer">
                  <constraints>
                    <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  </constraints>
                </hspacer>
              </children>
            </grid>

            <component id="built-label" class="javax.swing.JLabel" binding="builtLabel">
              <constraints>
                <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              </constraints>
              <properties>
                <text value="[built]"/>
              </properties>
            </component>
            <component id="built-value" class="javax.swing.JLabel" binding="builtValueLabel">
              <constraints>
                <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              </constraints>
              <properties>
                <text value=""/>
              </properties>
            </component>

            <component id="doc-label" class="javax.swing.JLabel" binding="documentationLabel">
              <constraints>
                <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              </constraints>
              <properties>
                <text value="[documentation]"/>
              </properties>
            </component>
            <component id="doc-link" class="com.intellij.ui.HyperlinkLabel" binding="readmeLink">
              <constraints>
                <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              </constraints>
              <properties/>
            </component>

            <vspacer id="overview-vspacer">
              <constraints>
                <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
              </constraints>
            </vspacer>
          </children>
        </grid>
</form>
