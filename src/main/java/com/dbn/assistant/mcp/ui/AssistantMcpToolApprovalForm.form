<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.assistant.mcp.ui.AssistantMcpToolApprovalForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="0">
    <margin top="0" left="0" bottom="16" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="120"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <vspacer id="ede0a">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="4"/>
          </grid>
        </constraints>
      </vspacer>
      <component id="fcb61" class="javax.swing.JLabel" binding="nameLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="[tool name]"/>
        </properties>
      </component>
      <hspacer id="fc108">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <component id="e8414" class="com.dbn.common.ui.misc.DBNToggleButton" binding="statusToggle">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="92" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <text value="[status]"/>
        </properties>
      </component>
      <grid id="3c46b" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="a3f89" class="javax.swing.JTextPane" binding="descriptionTextPane">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <editable value="false"/>
              <opaque value="false"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
