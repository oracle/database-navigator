        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="7af3b" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="BY"/>
            </properties>
          </component>
          <component id="90c31" class="javax.swing.JComboBox" binding="comboBox4" default-binding="true">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <model>
                <item value="WORDS"/>
