<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.vector.ui.request.bulk.TableSelectionForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="8" left="8" bottom="8" right="8"/>
    <constraints>
      <xy x="20" y="20" width="650" height="500"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <!-- Row 0: Instruction text -->
      <component id="instructionLbl" class="javax.swing.JLabel" binding="instructionLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/DBNResources" key="app.vector.text.BulkSelectionInstruction"/>
        </properties>
      </component>

      <!-- Row 1: Schema selector -->
      <grid id="schemaRow" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="8" left="0" bottom="8" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="schemaLbl" class="javax.swing.JLabel" binding="schemaLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <labelFor value="schemaCmb"/>
              <text resource-bundle="messages/DBNResources" key="app.vector.label.SchemaLabel"/>
            </properties>
          </component>
          <component id="schemaCmb" class="com.dbn.object.common.ui.DBObjectSelector" binding="schemaComboBox" custom-create="true">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="250" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <hspacer id="schemaSpacer">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
        </children>
      </grid>

      <!-- Row 2: Dual panel selection -->
      <grid id="selectionRow" layout-manager="GridLayoutManager" row-count="2" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="4">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <!-- Left panel: Available tables scroll pane -->
          <scrollpane id="availableScroll" binding="availableScrollPane">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="220" height="180"/>
              </grid>
            </constraints>
            <properties/>
            <border type="etched" title-resource-bundle="messages/DBNResources" title-key="app.vector.title.AvailableTables1"/>
            <children>
              <component id="availableLst" class="javax.swing.JList" binding="availableTablesList" custom-create="true">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>

          <!-- Left hint label -->
          <component id="availableHintLbl" class="javax.swing.JLabel" binding="availableHintLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="11"/>
              <foreground color="-6710887"/>
              <text resource-bundle="messages/DBNResources" key="app.vector.text.SelectSchemaToLoadTables"/>
            </properties>
          </component>

          <!-- Center: Transfer buttons -->
          <grid id="buttonPanel" binding="buttonPanel" layout-manager="GridLayoutManager" row-count="6" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="4">
            <margin top="0" left="4" bottom="0" right="4"/>
            <constraints>
              <grid row="0" column="1" row-span="2" col-span="1" vsize-policy="3" hsize-policy="0" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <vspacer id="btnTopSpacer">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
                </constraints>
              </vspacer>
              <component id="addBtn" class="javax.swing.JButton" binding="addButton">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text resource-bundle="messages/DBNResources" key="app.vector.button.MoveRight"/>
                  <toolTipText resource-bundle="messages/DBNResources" key="app.vector.tooltip.AddSelectedTables"/>
                </properties>
              </component>
              <component id="removeBtn" class="javax.swing.JButton" binding="removeButton">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text resource-bundle="messages/DBNResources" key="app.vector.button.MoveLeft"/>
                  <toolTipText resource-bundle="messages/DBNResources" key="app.vector.tooltip.RemoveSelectedTables"/>
                </properties>
              </component>
              <component id="addAllBtn" class="javax.swing.JButton" binding="addAllButton">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text resource-bundle="messages/DBNResources" key="app.vector.button.MoveAllRight"/>
                  <toolTipText resource-bundle="messages/DBNResources" key="app.vector.tooltip.AddAllTables"/>
                </properties>
              </component>
              <component id="removeAllBtn" class="javax.swing.JButton" binding="removeAllButton">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text resource-bundle="messages/DBNResources" key="app.vector.button.MoveAllLeft"/>
                  <toolTipText resource-bundle="messages/DBNResources" key="app.vector.tooltip.RemoveAllTables"/>
                </properties>
              </component>
              <vspacer id="btnBottomSpacer">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
                </constraints>
              </vspacer>
            </children>
          </grid>

          <!-- Right panel: Selected tables scroll pane -->
          <scrollpane id="selectedScroll" binding="selectedScrollPane">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="220" height="180"/>
              </grid>
            </constraints>
            <properties/>
            <border type="etched" title-resource-bundle="messages/DBNResources" title-key="app.vector.title.SelectedTables2"/>
            <children>
              <component id="selectedLst" class="javax.swing.JList" binding="selectedTablesList" custom-create="true">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>

          <!-- Right hint label -->
          <component id="selectedHintLbl" class="javax.swing.JLabel" binding="selectedHintLabel">
            <constraints>
              <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="11"/>
              <foreground color="-6710887"/>
              <text resource-bundle="messages/DBNResources" key="app.vector.text.UseToAddTablesHere"/>
            </properties>
          </component>
        </children>
      </grid>

      <!-- Row 3: Column configuration panel -->
      <grid id="configGrid" binding="configPanel" layout-manager="GridLayoutManager" row-count="4" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="4">
        <margin top="8" left="8" bottom="8" right="8"/>
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title-resource-bundle="messages/DBNResources" title-key="app.vector.title.ColumnConfiguration3"/>
        <children>
          <!-- Config hint row -->
          <component id="configHintLbl" class="javax.swing.JLabel" binding="configHintLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="11"/>
              <foreground color="-6710887"/>
              <text resource-bundle="messages/DBNResources" key="app.vector.text.TableConfigurationHint"/>
            </properties>
          </component>
          <!-- Table name row -->
          <component id="tableLbl" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text resource-bundle="messages/DBNResources" key="app.vector.label.TableLabel"/>
            </properties>
          </component>
          <component id="tableNameLbl" class="javax.swing.JLabel" binding="selectedTableLabel">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font style="1"/>
              <text resource-bundle="messages/DBNResources" key="app.vector.label.None"/>
            </properties>
          </component>
          <hspacer id="configSpacer">
            <constraints>
              <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <!-- ID Column row -->
          <component id="keyColLbl" class="javax.swing.JLabel" binding="keyColumnLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <labelFor value="keyColCmb"/>
              <text resource-bundle="messages/DBNResources" key="app.vector.label.IDColumn"/>
              <toolTipText resource-bundle="messages/DBNResources" key="app.vector.tooltip.PrimaryKeyColumn"/>
            </properties>
          </component>
          <component id="keyColCmb" class="com.dbn.object.common.ui.DBObjectSelector" binding="keyColumnComboBox" custom-create="true">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="250" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <!-- Data Column row -->
          <component id="dataColLbl" class="javax.swing.JLabel" binding="dataColumnLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <labelFor value="dataColCmb"/>
              <text resource-bundle="messages/DBNResources" key="app.vector.label.DataColumnLabel"/>
              <toolTipText resource-bundle="messages/DBNResources" key="app.vector.tooltip.TextColumnContainingDataToEmbed"/>
            </properties>
          </component>
          <component id="dataColCmb" class="com.dbn.object.common.ui.DBObjectSelector" binding="dataColumnComboBox" custom-create="true">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="250" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
