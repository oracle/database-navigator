<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.vector.ui.request.EmbeddingSourceConfigForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="8" bottom="0" right="8"/>
    <constraints>
      <xy x="20" y="20" width="582" height="63"/>
    </constraints>
    <properties>
      <doubleBuffered value="false"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="a8cbd" binding="dataPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <component id="350cc" class="javax.swing.JLabel" binding="sourceLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="1b5ec"/>
          <text resource-bundle="messages/DBNResources" key="app.vector.label.SourceTypeMnemonic"/>
        </properties>
      </component>
      <component id="1b5ec" class="javax.swing.JComboBox" binding="sourceComboBox">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="Table"/>
            <item value="Filesystem"/>
          </model>
        </properties>
      </component>
      <hspacer id="180af">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
    </children>
  </grid>
</form>
