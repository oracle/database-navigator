<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.vector.ui.VectorAIForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="888"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="6e7a8" class="com.dbn.common.ui.misc.DBNScrollPane" default-binding="true">
