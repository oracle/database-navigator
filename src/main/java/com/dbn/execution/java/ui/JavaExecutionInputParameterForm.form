<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.execution.java.ui.JavaExecutionInputParameterForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="-1">
    <margin top="0" left="0" bottom="0" right="8"/>
    <constraints>
      <xy x="20" y="20" width="500" height="92"/>
    </constraints>
    <properties/>
    <border type="none">
      <size top="0" left="4" bottom="0" right="4"/>
      <color color="-16777216"/>
    </border>
    <children>
      <component id="e3511" class="javax.swing.JLabel" binding="parameterTypeLabel">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="[parameter type]"/>
        </properties>
      </component>
      <component id="3bf57" class="javax.swing.JLabel" binding="parameterLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="[parameter]"/>
        </properties>
      </component>
      <grid id="351ef" binding="inputFieldPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="1410c" class="javax.swing.JComboBox" binding="inputModeComboBox">
            <constraints border-constraint="East"/>
            <properties/>
          </component>
        </children>
      </grid>
      <grid id="b4e26" binding="inputFieldsPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <grid id="94119" binding="inputCodePanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
    </children>
  </grid>
</form>
