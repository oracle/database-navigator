<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.liquibase.operation.ui.LiquibaseOperationResultForm">
  <grid id="1" binding="mainPanel" layout-manager="GridLayoutManager" row-count="1" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
    <margin top="2" left="0" bottom="2" right="2"/>
    <constraints>
      <xy x="20" y="20" width="468" height="360"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="2" binding="actionsPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <component id="3" class="javax.swing.JSeparator">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <orientation value="1"/>
        </properties>
      </component>
      <grid id="4" binding="summaryPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <component id="5" class="javax.swing.JTabbedPane" binding="contentTabbedPane">
        <constraints>
          <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="a1140" class="javax.swing.JSeparator">
        <constraints>
          <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="6" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <orientation value="1"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
