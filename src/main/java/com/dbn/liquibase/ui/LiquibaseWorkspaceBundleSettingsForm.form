<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.liquibase.ui.LiquibaseWorkspaceBundleSettingsForm">
  <grid id="1" binding="mainPanel" layout-manager="BorderLayout"><margin top="0" left="0" bottom="4" right="0"/><constraints><xy x="20" y="20" width="700" height="450"/></constraints><properties/><border type="none"/><children>
    <splitpane id="2"><constraints border-constraint="Center"/><properties><dividerLocation value="220"/></properties><border type="none"/><children>
      <grid id="3" binding="artifactsPanel" layout-manager="BorderLayout"><constraints><splitpane position="left"/></constraints><properties/><border type="none"/><children>
        <scrollpane id="4" class="com.intellij.ui.components.JBScrollPane"><constraints border-constraint="Center"/><properties/><border type="none"/><children>
          <component id="5" class="javax.swing.JList" binding="artifactsList"><constraints/><properties><selectionMode value="0"/></properties></component>
        </children></scrollpane>
      </children></grid>
      <grid id="5" binding="detailsPanel" layout-manager="BorderLayout"><constraints><splitpane position="right"/></constraints><properties/><border type="none"/><children/></grid>
    </children></splitpane>
  </children></grid>
</form>
