<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.driver.packages.ui.DriverPackageInfoForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="3fd9b" binding="headerPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="empty">
          <size top="50" left="50" bottom="0" right="0"/>
        </border>
        <children/>
      </grid>
      <scrollpane id="bfb69">
        <constraints border-constraint="Center"/>
        <properties>
          <focusTraversalPolicyProvider value="true"/>
          <maximumSize width="32767" height="500"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="f6a62" binding="infoPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
            <constraints/>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
