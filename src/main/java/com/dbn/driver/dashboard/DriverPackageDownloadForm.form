<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.driver.dashboard.DriverPackageDownloadForm">
  <grid id="downloadRoot" binding="mainPanel" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="8">
    <margin top="8" left="8" bottom="8" right="8"/>
    <constraints>
      <xy x="20" y="20" width="620" height="196"/>
    </constraints>
    <properties>
      <preferredSize width="640" height="200"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="headerPanel" binding="headerPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <component id="downloadRootLabel" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="downloadRootField"/>
          <text resource-bundle="messages/DBNResources" key="app.driver.label.DownloadRootLocation"/>
        </properties>
      </component>
      <component id="downloadRootField" class="com.intellij.openapi.ui.TextFieldWithBrowseButton" binding="downloadRootField">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="480" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="packageFolderLabel" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="packageFolderField"/>
          <text resource-bundle="messages/DBNResources" key="app.driver.label.PackageFolder"/>
        </properties>
      </component>
      <component id="packageFolderField" class="javax.swing.JTextField" binding="packageFolderField">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="downloadPathLabel" class="com.dbn.common.ui.info.DBNCommentLabel" binding="downloadPathLabel">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <vspacer id="downloadSpacer">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
