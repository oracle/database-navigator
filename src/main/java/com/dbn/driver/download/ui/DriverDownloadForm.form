<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.driver.download.ui.DriverDownloadForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="4" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="596" height="143"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <vspacer id="91ef">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
      <component id="1c19a" class="javax.swing.JComboBox" binding="libraryPackageComboBox">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="400" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <model/>
        </properties>
      </component>
      <component id="bde6c" class="javax.swing.JLabel" binding="libraryPathLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="28d7e"/>
          <text resource-bundle="messages/DBNResources" key="app.driver.label.DownloadPath"/>
        </properties>
      </component>
      <component id="28d7e" class="com.intellij.openapi.ui.TextFieldWithBrowseButton" binding="libraryPathTextField">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <focusable value="false"/>
        </properties>
      </component>
      <component id="f9ccd" class="javax.swing.JLabel" binding="errorHintLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/DBNResources" key="app.driver.placeholder.ErrorHint"/>
        </properties>
      </component>
      <component id="96f99" class="javax.swing.JLabel" binding="libraryPackageLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="1c19a"/>
          <text resource-bundle="messages/DBNResources" key="app.driver.label.Package"/>
        </properties>
      </component>
      <component id="20cc1" class="javax.swing.JButton" binding="infoButton">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/DBNResources" key="app.driver.button.Browse"/>
          <toolTipText resource-bundle="messages/DBNResources" key="app.driver.tooltip.DriverLibrariesInfo"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
