<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.ml.result.MLMetricCardPanel">
  <grid id="mc_root" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="1"
        same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="4">
    <margin top="12" left="12" bottom="12" right="12"/>
    <constraints>
      <xy x="20" y="20" width="120" height="80"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>

      <!-- Metric name (small, gray) -->
      <component id="mc_name" class="javax.swing.JLabel" binding="nameLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Metric"/>
        </properties>
      </component>

      <!-- Metric value (large, bold) -->
      <component id="mc_value" class="javax.swing.JLabel" binding="valueLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="0.0%"/>
        </properties>
      </component>

      <!-- Progress bar slot (hidden for non-ratio metrics) -->
      <grid id="mc_bar" binding="progressBarContainer" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="4"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>

    </children>
  </grid>
</form>
