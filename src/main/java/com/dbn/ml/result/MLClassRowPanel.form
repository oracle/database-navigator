<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.ml.result.MLClassRowPanel">
  <grid id="cr_root" binding="mainPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2"
        same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="24"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>

      <!-- Left: class name and sample count -->
      <grid id="cr_left" binding="namePanel" layout-manager="GridLayoutManager" row-count="1" column-count="2"
            same-size-horizontally="false" same-size-vertically="false" hgap="4" vgap="0">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="180" height="24"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>

          <component id="cr_name" class="javax.swing.JLabel" binding="nameLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Class"/>
            </properties>
          </component>

          <component id="cr_support" class="javax.swing.JLabel" binding="supportLabel">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="(n=0)"/>
            </properties>
          </component>

        </children>
      </grid>

      <!-- Right: P / R / F1 metric bars (populated programmatically) -->
      <grid id="cr_metrics" binding="metricsPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1"
            same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="24"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>

    </children>
  </grid>
</form>
