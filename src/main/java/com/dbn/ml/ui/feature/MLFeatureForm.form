<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.ml.ui.feature.MLFeatureForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="8" bottom="0" right="8"/>
    <constraints>
      <xy x="20" y="20" width="400" height="160"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="a1b2c" class="javax.swing.JLabel" binding="featuresLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="&amp;Features"/>
        </properties>
      </component>
      <scrollpane id="d3e4f" class="com.intellij.ui.components.JBScrollPane" binding="featuresScrollPane">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="2" anchor="8" fill="3" indent="0" use-parent-layout="false">
            <minimum-size width="150" height="80"/>
            <preferred-size width="200" height="100"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </scrollpane>
      <hspacer id="g5h6i">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <component id="j7k8l" class="javax.swing.JLabel" binding="labelLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="&amp;Label (Target)"/>
        </properties>
      </component>
      <component id="m9n0o" class="com.dbn.object.common.ui.DBObjectSelector" binding="labelComboBox">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="200" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
    </children>
  </grid>
</form>
