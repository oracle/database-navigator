<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.ml.ui.source.MLSourceFileForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="100"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="a1b2c" class="javax.swing.JLabel" binding="fileLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/DBNResources" key="cfg.machineLearning.label.File"/>
        </properties>
      </component>
      <component id="d3e4f" class="com.intellij.openapi.ui.TextFieldWithBrowseButton" binding="filePathField">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="300" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <hspacer id="180af">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <component id="g5h6i" class="javax.swing.JLabel" binding="delimiterLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/DBNResources" key="cfg.machineLearning.label.Delimiter"/>
        </properties>
      </component>
      <component id="j7k8l" class="javax.swing.JTextField" binding="delimiterField">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="50" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <text value=","/>
        </properties>
      </component>
      <component id="m8n9o" class="javax.swing.JLabel" binding="hasHeaderLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/DBNResources" key="cfg.machineLearning.label.HasHeader"/>
        </properties>
      </component>
      <component id="p0q1r" class="javax.swing.JCheckBox" binding="hasHeaderCheckBox">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <selected value="true"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
