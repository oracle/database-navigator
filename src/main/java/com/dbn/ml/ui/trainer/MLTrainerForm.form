<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.ml.ui.trainer.MLTrainerForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="6" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="8" bottom="0" right="8"/>
    <constraints>
      <xy x="20" y="20" width="400" height="210"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="e0f1g" class="javax.swing.JLabel" binding="modelNameLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Model &amp;Name"/>
        </properties>
      </component>
      <component id="h2i3j" class="javax.swing.JTextField" binding="modelNameField">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="200" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <hspacer id="k4l5m">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
