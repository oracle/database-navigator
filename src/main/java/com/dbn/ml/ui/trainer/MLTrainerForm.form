            <preferred-size width="120" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <text value="70% Train / 30% Test"/>
        </properties>
      </component>
      <component id="v5w6x" class="javax.swing.JCheckBox" binding="useFixedSeedCheckBox">
        <constraints>
