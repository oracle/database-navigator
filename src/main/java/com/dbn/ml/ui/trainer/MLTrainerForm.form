        </constraints>
        <properties>
          <text value="&amp;Algorithm"/>
        </properties>
      </component>
      <component id="d3e4f" class="com.dbn.common.ui.misc.DBNComboBox" binding="algorithmComboBox">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="200" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <hspacer id="g5h6i">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <component id="j7k8l" class="javax.swing.JTextArea" binding="descriptionTextArea">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="200" height="36"/>
          </grid>
        </constraints>
        <properties>
          <editable value="false"/>
          <lineWrap value="true"/>
          <wrapStyleWord value="true"/>
          <opaque value="false"/>
        </properties>
      </component>
      <component id="m9n0o" class="javax.swing.JLabel" binding="splitLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Train/Test &amp;Split"/>
        </properties>
      </component>
      <component id="p1q2r" class="javax.swing.JSlider" binding="splitSlider">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="200" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <majorTickSpacing value="10"/>
          <maximum value="90"/>
          <minimum value="10"/>
          <paintLabels value="false"/>
          <paintTicks value="true"/>
          <value value="70"/>
