        </constraints>
      </vspacer>
      <grid id="54951" binding="messagePanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
    </children>
  </grid>
</form>
