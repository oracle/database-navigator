<token-def>
    <tokens>
        <token id="WHITE_SPACE" category="whitespace"/>

        <!-- CHARACTERS -->
        <token category="character" index="0" id="CHR_AT" value="@"/>
        <token category="character" index="1" id="CHR_COLON" value=":"/>
        <token category="character" index="2" id="CHR_COMMA" value="," formatting-spacing-before="NO_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="character" index="3" id="CHR_DOT" value="." formatting-spacing-before="NO_SPACE" formatting-spacing-after="NO_SPACE"/>
        <token category="character" index="4" id="CHR_EQUAL" value="=" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="character" index="5" id="CHR_EXCLAMATION" value="!" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="character" index="6" id="CHR_GREATER" value="&#62;" />
        <token category="character" index="7" id="CHR_HASH" value="#"/>
        <token category="character" index="8" id="CHR_LEFT_BRACKET" value="[" formatting-spacing-after="NO_SPACE"/>
        <token category="character" index="9" id="CHR_LEFT_BRACE" value="{" formatting-spacing-after="NO_SPACE"/>
        <token category="character" index="10" id="CHR_LEFT_PARENTHESIS" value="(" formatting-spacing-after="NO_SPACE"/>
        <token category="character" index="11" id="CHR_LESS" value="&#60;" />
        <token category="character" index="12" id="CHR_MINUS" value="-"/>
        <token category="character" index="13" id="CHR_PERCENT" value="%"/>
        <token category="character" index="14" id="CHR_PLUS" value="+"/>
        <token category="character" index="15" id="CHR_RIGHT_BRACKET" value="]" formatting-spacing-before="NO_SPACE"/>
        <token category="character" index="16" id="CHR_RIGHT_BRACE" value="}" formatting-spacing-before="NO_SPACE"/>
        <token category="character" index="17" id="CHR_RIGHT_PARENTHESIS" value=")" formatting-spacing-before="NO_SPACE"/>
        <token category="character" index="18" id="CHR_SEMICOLON" value=";" formatting-spacing-before="NO_SPACE"/>
        <token category="character" index="19" id="CHR_SLASH" value="/" formatting-wrap="ALWAYS" formatting-indend="ABSOLUTE_NONE"/>
        <token category="character" index="20" id="CHR_STAR" value="*"/>
        <token category="character" index="21" id="CHR_VERTICAL_BAR" value="|"/>
        <token category="character" index="22" id="CHR_AND" value="&#38;"/>
        <token category="character" index="23" id="CHR_TILDE" value="~"/>
        <token category="character" index="24" id="CHR_CARET" value="^"/>
        <token category="character" index="25" id="CHR_QUESTION_MARK" value="?"/>


        <token category="operator" index="0" id="OPR_EQUAL_EQUAL" value="==" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="1" id="OPR_CONCATENATION" value="||" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="2" id="OPR_LESS_EQUAL" value="&#60;=" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="3" id="OPR_GREATER_EQUAL" value="&#62;=" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="4" id="OPR_LESS_GREATER" value="&#60;&#62;" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="5" id="OPR_NOT_EQUAL" value="!=" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="6" id="OPR_ASSIGNMENT" value=":=" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="7" id="OPR_EQUAL_GREATER" value="=&#62;" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="8" id="OPR_RANGE_DOTS" value=".." formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="9" id="OPR_CAST_PREFIX" value="::" formatting-spacing-before="NO_SPACE" formatting-spacing-after="NO_SPACE"/>
        <token category="operator" index="10" id="OPR_LIKE" value="~~" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="11" id="OPR_NOT_LIKE" value="!~~" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="12" id="OPR_MATCH" value="~" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="13" id="OPR_MATCH_CI" value="~*" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="14" id="OPR_NO_MATCH" value="!~" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="15" id="OPR_NO_MATCH_CI" value="!~*" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="16" id="OPR_NULL_SAFE_EQUAL" value="&#60;=&#62;" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="17" id="OPR_SHIFT_LEFT" value="&#60;&#60;" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>
        <token category="operator" index="18" id="OPR_SHIFT_RIGHT" value="&#62;&#62;" formatting-spacing-before="ONE_SPACE" formatting-spacing-after="ONE_SPACE"/>





        <token id="LINE_COMMENT" category="comment"/>
        <token id="BLOCK_COMMENT" category="comment"/>

        <token id="IDENTIFIER" category="identifier"/>

        <token id="INTEGER" category="numeric"/>
        <token id="NUMBER" category="numeric"/>
        <token id="STRING" category="literal"/>
        <token id="OPERATOR" category="operator"/>
        <token id="VARIABLE" category="variable"/>
    </tokens>

    <token-sets>
        <token-set id="WHITE_SPACES">WHITE_SPACE</token-set>
        <token-set id="PARENTHESES">CHR_LEFT_PARENTHESIS, CHR_RIGHT_PARENTHESIS</token-set>
        <token-set id="BRACKETS">CHR_LEFT_BRACKET, CHR_RIGHT_BRACKET</token-set>
        <token-set id="BRACES">CHR_LEFT_BRACE, CHR_RIGHT_BRACE</token-set>
        <token-set id="COMMENTS">LINE_COMMENT, BLOCK_COMMENT</token-set>
        <token-set id="IDENTIFIERS">IDENTIFIER</token-set>
        <token-set id="NUMBERS">INTEGER, NUMBER</token-set>
        <token-set id="OPERATORS">OPR_CONCATENATION, OPR_ASSIGNMENT, OPR_RANGE_DOTS, OPR_CAST_PREFIX</token-set>
        <token-set id="STRINGS">STRING</token-set>
        <token-set id="VARIABLES">VARIABLE</token-set>
    </token-sets>
</token-def>
