<element-defs language="ISO92-SQL" version="SQL 92">
    <element-def attributes="ROOT, STRUCTURE" custom="true" description="SQL block" id="sql_block" language="SQL">
        <iteration id="00000">
            <one-of attributes="STATEMENT" id="00001">
                <element ref-id="query_specification" />
                <element ref-id="delete_statement" />
                <element ref-id="insert_statement" />
                <element ref-id="update_statement" />
            </one-of>
        </iteration>
    </element-def>

    <!-- ========= select ========= -->
    <element-def attributes="EXECUTABLE, DATA_MANIPULATION, QUERY, STRUCTURE" description="Query specification" id="query_specification">
        <token id="00002" type-id="KW_SELECT" />
        <element optional="true" ref-id="set_quantifier" />
        <element ref-id="select_list" />
        <element ref-id="table_expression" />
    </element-def>

    <!-- ========= insert ========= -->
    <element-def attributes="EXECUTABLE, DATA_MANIPULATION, TRANSACTIONAL, STRUCTURE" description="INSERT statement" id="insert_statement">
        <token type-id="KW_INSERT" />
        <token type-id="KW_INTO" />
        <element ref-id="table_name" />
        <wrapper optional="true" template="PARENTHESES">
            <iteration separator="CHR_COMMA">
                <object-ref type="COLUMN" />
            </iteration>
        </wrapper>
        <one-of ambiguous="true">
            <element ref-id="insert_values_clause" />
            <element ref-id="query_specification" />
        </one-of>
    </element-def>
    <element-def attributes="CLAUSE" custom="true" description="INSERT VALUES clause" id="insert_values_clause">
        <token type-id="KW_VALUES" />
        <wrapper template="PARENTHESES">
            <iteration separator="CHR_COMMA">
                <element ref-id="insert_value" />
            </iteration>
        </wrapper>
    </element-def>
    <element-def custom="true" description="INSERT value" id="insert_value">
        <one-of ambiguous="true">
            <token type-id="KW_DEFAULT" />
            <element ref-id="value_expression" />
        </one-of>
    </element-def>

    <!-- ========= update ========= -->
    <element-def attributes="EXECUTABLE, DATA_MANIPULATION, TRANSACTIONAL, STRUCTURE" description="UPDATE statement" id="update_statement">
        <token type-id="KW_UPDATE" />
        <element ref-id="table_name" />
        <element ref-id="set_clause" />
        <element optional="true" ref-id="where_clause" />
    </element-def>
    <element-def attributes="CLAUSE" custom="true" description="SET clause" id="set_clause">
        <token type-id="KW_SET" />
        <iteration separator="CHR_COMMA">
            <element ref-id="set_clause_item" />
        </iteration>
    </element-def>
    <element-def custom="true" description="SET clause item" id="set_clause_item">
        <object-ref type="COLUMN" />
        <token type-id="CHR_EQUAL" />
        <element ref-id="update_source" />
    </element-def>
    <element-def description="UPDATE source" id="update_source">
        <one-of ambiguous="true">
            <token type-id="KW_DEFAULT" />
            <element ref-id="value_expression" />
        </one-of>
    </element-def>

    <!-- ========= delete ========= -->
    <element-def attributes="EXECUTABLE, DATA_MANIPULATION, TRANSACTIONAL, STRUCTURE" description="DELETE statement" id="delete_statement">
        <token type-id="KW_DELETE" />
        <token type-id="KW_FROM" />
        <element ref-id="table_name" />
        <element optional="true" ref-id="where_clause" />
    </element-def>

    <element-def description="Set quantifier" id="set_quantifier">
        <one-of id="00003">
            <token id="00004" type-id="KW_DISTINCT" />
            <token id="00005" type-id="KW_ALL" />
        </one-of>
    </element-def>
    <element-def description="Select list" id="select_list">
        <one-of id="00006" ambiguous="true">
            <token id="00007" original-name="asterisk" type-id="CHR_STAR" />
            <iteration id="00008" separator="CHR_COMMA">
                <element ref-id="select_sublist" />
            </iteration>
        </one-of>
    </element-def>
    <element-def description="Select sublist" id="select_sublist">
        <one-of id="00009" ambiguous="true">
            <element ref-id="derived_column" />
            <sequence id="00010">
                <element ref-id="qualifier" />
                <element ref-id="period" />
                <token id="00011" original-name="asterisk" type-id="CHR_STAR" />
            </sequence>
        </one-of>
    </element-def>
    <element-def description="Derived column" id="derived_column">
        <element ref-id="value_expression" />
        <element optional="true" ref-id="as_clause" />
    </element-def>
    <element-def description="AS clause" id="as_clause">
        <token id="00012" optional="true" type-id="KW_AS" />
        <alias-def id="00013" original-name="column_name" type="COLUMN" />
    </element-def>
    <element-def description="Value expression" id="value_expression">
        <one-of id="00014" ambiguous="true">
            <element ref-id="numeric_value_expression" />
            <element ref-id="string_value_expression" />
            <element ref-id="datetime_value_expression" />
            <element ref-id="interval_value_expression" />
        </one-of>
    </element-def>
    <element-def description="Numeric value expression" id="numeric_value_expression">
        <element ref-id="term" />
        <iteration optional="true" id="00015">
            <sequence id="00016">
                <one-of id="00017">
                    <token type-id="CHR_PLUS" id="00018" />
                    <token type-id="CHR_MINUS" id="00019" />
                </one-of>
                <element ref-id="term" />
            </sequence>
        </iteration>
    </element-def>
    <element-def description="Term" id="term">
        <element ref-id="factor" />
        <iteration optional="true" id="00020">
            <sequence id="00021">
                <one-of id="00022">
                    <token original-name="asterisk" type-id="CHR_STAR" id="00023" />
                    <token original-name="solidus" type-id="CHR_SLASH" id="00024" />
                </one-of>
                <element ref-id="factor" />
            </sequence>
        </iteration>
    </element-def>
    <element-def description="Sign" id="sign">
        <one-of id="00025">
            <token type-id="CHR_PLUS" id="00026" />
            <token type-id="CHR_MINUS" id="00027" />
        </one-of>
    </element-def>
    <element-def description="Table expression" id="table_expression">
        <element ref-id="from_clause" />
        <element optional="true" ref-id="where_clause" />
        <element optional="true" ref-id="group_by_clause" />
        <element optional="true" ref-id="having_clause" />
    </element-def>
    <element-def attributes="CLAUSE" description="FROM clause" id="from_clause">
        <token type-id="KW_FROM" id="00028" />
        <iteration separator="CHR_COMMA" id="00029">
            <element ref-id="table_reference" />
        </iteration>
    </element-def>
    <element-def description="Table reference" id="table_reference">
        <one-of id="00030" ambiguous="true">
            <element ref-id="table_name" />
            <element ref-id="derived_table" />
        </one-of>
        <element optional="true" ref-id="correlation_specification" />
    </element-def>
    <element-def description="Table name" id="table_name">
        <qualified-identifier separator="CHR_DOT" id="00031">
            <variant>
                <object-ref optional="true" type="SCHEMA" id="00032" />
                <object-ref attributes="SUBJECT" type="TABLE" id="00033" />
            </variant>
        </qualified-identifier>
    </element-def>
    <element-def description="Derived table" id="derived_table">
        <wrapper template="PARENTHESES" id="00034">
            <element ref-id="query_specification" />
        </wrapper>
    </element-def>
    <element-def description="Correlation specification" id="correlation_specification">
        <token optional="true" type-id="KW_AS" id="00035" />
        <alias-def type="DATASET" id="00036" />
        <wrapper optional="true" template="PARENTHESES" id="00037">
            <iteration separator="CHR_COMMA" id="00038">
                <alias-def original-name="column_name" type="COLUMN" id="00039" />
            </iteration>
        </wrapper>
    </element-def>
    <element-def attributes="CLAUSE" description="WHERE clause" id="where_clause">
        <token type-id="KW_WHERE" id="00040" />
        <element ref-id="search_condition" />
    </element-def>
    <element-def attributes="CLAUSE" description="GROUP BY clause" id="group_by_clause">
        <token type-id="KW_GROUP" id="00041" />
        <token type-id="KW_BY" id="00042" />
        <iteration separator="CHR_COMMA" id="00043">
            <element ref-id="grouping_column_reference" />
        </iteration>
    </element-def>
    <element-def description="Grouping column reference" id="grouping_column_reference">
        <element ref-id="column_reference" />
    </element-def>
    <element-def attributes="CLAUSE" description="HAVING clause" id="having_clause">
        <token type-id="KW_HAVING" id="00044" />
        <element ref-id="search_condition" />
    </element-def>
    <element-def description="Search condition" id="search_condition">
        <element ref-id="boolean_term" />
        <iteration optional="true" id="00045">
            <sequence id="00046">
                <token type-id="KW_OR" id="00047" />
                <element ref-id="boolean_term" />
            </sequence>
        </iteration>
    </element-def>
    <element-def description="Boolean term" id="boolean_term">
        <element ref-id="boolean_factor" />
        <iteration optional="true" id="00048">
            <sequence id="00049">
                <token type-id="KW_AND" id="00050" />
                <element ref-id="boolean_factor" />
            </sequence>
        </iteration>
    </element-def>
    <element-def description="Boolean factor" id="boolean_factor">
        <token optional="true" type-id="KW_NOT" id="00051" />
        <element ref-id="boolean_test" />
    </element-def>
    <element-def description="Boolean test" id="boolean_test">
        <element ref-id="boolean_primary" />
        <sequence optional="true" id="00052">
            <token type-id="KW_IS" id="00053" />
            <token optional="true" type-id="KW_NOT" id="00054" />
            <element ref-id="truth_value" />
        </sequence>
    </element-def>
    <element-def description="Truth value" id="truth_value">
        <one-of id="00055">
            <token type-id="KW_TRUE" id="00056" />
            <token type-id="KW_FALSE" id="00057" />
            <token type-id="KW_UNKNOWN" id="00058" />
        </one-of>
    </element-def>
    <element-def description="Boolean primary" id="boolean_primary">
        <one-of id="00059" ambiguous="true">
            <element ref-id="predicate" />
            <wrapper template="PARENTHESES" id="00060">
                <element ref-id="search_condition" />
            </wrapper>
        </one-of>
    </element-def>
    <element-def description="Predicate" id="predicate">
        <one-of id="00061" ambiguous="true">
            <element ref-id="comparison_predicate" />
            <element ref-id="null_predicate" />
            <element ref-id="like_predicate" />
            <element ref-id="between_predicate" />
            <element ref-id="in_predicate" />
            <element ref-id="exists_predicate" />
            <element ref-id="quantified_comparison_predicate" />
            <element ref-id="unique_predicate" />
            <element ref-id="match_predicate" />
            <element ref-id="overlaps_predicate" />
        </one-of>
    </element-def>
    <element-def description="Comparison predicate" id="comparison_predicate">
        <element ref-id="row_value_constructor" />
        <element ref-id="comparison_operator" />
        <element ref-id="row_value_constructor" />
    </element-def>
    <element-def description="Comparison operator" id="comparison_operator">
        <one-of id="00062">
            <token type-id="CHR_EQUAL" id="00063" />
            <token type-id="CHR_LESS" id="00064" />
            <token type-id="CHR_GREATER" id="00065" />
            <token type-id="OPR_LESS_EQUAL" id="00066" />
            <token type-id="OPR_GREATER_EQUAL" id="00067" />
            <token type-id="OPR_LESS_GREATER" id="00068" />
        </one-of>
    </element-def>
    <element-def description="Row value constructor" id="row_value_constructor">
        <one-of id="00069" ambiguous="true">
            <element ref-id="value_expression" />
            <wrapper template="PARENTHESES" id="00070">
                <iteration separator="CHR_COMMA" id="00071">
                    <element ref-id="value_expression" />
                </iteration>
            </wrapper>
        </one-of>
    </element-def>
    <element-def description="NULL predicate" id="null_predicate">
        <element ref-id="row_value_constructor" />
        <token type-id="KW_IS" id="00072" />
        <token optional="true" type-id="KW_NOT" id="00073" />
        <token type-id="KW_NULL" id="00074" />
    </element-def>
    <element-def description="LIKE predicate" id="like_predicate">
        <element ref-id="match_value" />
        <token optional="true" type-id="KW_NOT" id="00075" />
        <token type-id="KW_LIKE" id="00076" />
        <element ref-id="pattern" />
        <sequence optional="true">
            <token type-id="KW_ESCAPE" />
            <element ref-id="escape_character" />
        </sequence>
    </element-def>
    <element-def description="Match value" id="match_value">
        <element ref-id="character_value_expression" />
    </element-def>
    <element-def description="Pattern" id="pattern">
        <element ref-id="character_value_expression" />
    </element-def>
    <element-def description="Escape character" id="escape_character">
        <element ref-id="character_value_expression" />
    </element-def>
    <element-def description="BETWEEN predicate" id="between_predicate">
        <element ref-id="row_value_constructor" />
        <token optional="true" type-id="KW_NOT" id="00077" />
        <token type-id="KW_BETWEEN" id="00078" />
        <element ref-id="row_value_constructor" />
        <token type-id="KW_AND" id="00079" />
        <element ref-id="row_value_constructor" />
    </element-def>
    <element-def description="IN predicate" id="in_predicate">
        <element ref-id="row_value_constructor" />
        <token optional="true" type-id="KW_NOT" id="00080" />
        <token type-id="KW_IN" id="00081" />
        <one-of id="00082" ambiguous="true">
            <element ref-id="table_subquery" />
            <wrapper template="PARENTHESES" id="00083">
                <iteration separator="CHR_COMMA" id="00084">
                    <element ref-id="value_expression" />
                </iteration>
            </wrapper>
        </one-of>
    </element-def>
    <element-def description="EXISTS predicate" id="exists_predicate">
        <token type-id="KW_EXISTS" id="00085" />
        <element ref-id="table_subquery" />
    </element-def>
    <element-def description="Quantified comparison predicate" id="quantified_comparison_predicate">
        <element ref-id="row_value_constructor" />
        <element ref-id="comparison_operator" />
        <element ref-id="quantifier" />
        <element ref-id="table_subquery" />
    </element-def>
    <element-def description="Quantifier" id="quantifier">
        <one-of>
            <token type-id="KW_ALL" />
            <token type-id="KW_SOME" />
            <token type-id="KW_ANY" />
        </one-of>
    </element-def>
    <element-def description="UNIQUE predicate" id="unique_predicate">
        <token type-id="KW_UNIQUE" />
        <element ref-id="table_subquery" />
    </element-def>
    <element-def description="MATCH predicate" id="match_predicate">
        <element ref-id="row_value_constructor" />
        <token type-id="KW_MATCH" />
        <element optional="true" ref-id="unique_specification" />
        <element optional="true" ref-id="match_type" />
        <element ref-id="table_subquery" />
    </element-def>
    <element-def description="Unique specification" id="unique_specification">
        <token type-id="KW_UNIQUE" />
    </element-def>
    <element-def description="Match type" id="match_type">
        <one-of>
            <token type-id="KW_SIMPLE" />
            <token type-id="KW_PARTIAL" />
            <token type-id="KW_FULL" />
        </one-of>
    </element-def>
    <element-def description="OVERLAPS predicate" id="overlaps_predicate">
        <element ref-id="row_value_constructor" />
        <token type-id="KW_OVERLAPS" />
        <element ref-id="row_value_constructor" />
    </element-def>
    <element-def description="Table subquery" id="table_subquery">
        <wrapper template="PARENTHESES" id="00086">
            <element ref-id="query_specification" />
        </wrapper>
    </element-def>
    <element-def description="Qualifier" id="qualifier">
        <one-of id="00087" ambiguous="true">
            <object-ref type="DATASET" id="00088" />
            <alias-ref type="DATASET" id="00089" />
        </one-of>
    </element-def>
    <element-def description="Period" id="period">
        <token type-id="CHR_DOT" id="00090" />
    </element-def>
    <element-def description="Column reference" id="column_reference">
        <qualified-identifier separator="CHR_DOT" id="00091">
            <variant>
                <object-ref optional="true" type="DATASET" id="00092" />
                <object-ref type="COLUMN" id="00093" />
            </variant>
            <variant>
                <alias-ref optional="true" type="DATASET" id="00094" />
                <object-ref type="COLUMN" id="00095" />
            </variant>
        </qualified-identifier>
    </element-def>
    <element-def description="String value expression" id="string_value_expression">
        <element ref-id="character_value_expression" />
    </element-def>
    <element-def description="Character value expression" id="character_value_expression">
        <element ref-id="character_factor" />
        <iteration optional="true" id="00096">
            <sequence id="00097">
                <token type-id="OPR_CONCATENATION" id="00098" />
                <element ref-id="character_factor" />
            </sequence>
        </iteration>
    </element-def>
    <element-def description="Character factor" id="character_factor">
        <one-of id="00099" ambiguous="true">
            <element ref-id="character_primary" />
            <element ref-id="column_reference" />
        </one-of>
    </element-def>
    <element-def description="Character primary" id="character_primary">
        <one-of id="00100" ambiguous="true">
            <token type-id="STRING" id="00101" />
            <element ref-id="general_value_specification" />
        </one-of>
    </element-def>
    <element-def description="Datetime value expression" id="datetime_value_expression">
        <one-of id="00102" ambiguous="true">
            <element ref-id="datetime_primary" />
            <element ref-id="column_reference" />
        </one-of>
    </element-def>
    <element-def description="Datetime primary" id="datetime_primary">
        <one-of id="00103" ambiguous="true">
            <element ref-id="general_value_specification" />
            <element ref-id="unsigned_literal" />
        </one-of>
    </element-def>
    <element-def description="Interval value expression" id="interval_value_expression">
        <one-of id="00104" ambiguous="true">
            <element ref-id="interval_primary" />
            <element ref-id="column_reference" />
        </one-of>
    </element-def>
    <element-def description="Interval primary" id="interval_primary">
        <one-of id="00105" ambiguous="true">
            <element ref-id="general_value_specification" />
            <element ref-id="unsigned_literal" />
        </one-of>
    </element-def>
    <element-def description="Factor" id="factor">
        <element optional="true" ref-id="sign" />
        <element ref-id="numeric_primary" />
    </element-def>
    <element-def description="Numeric primary" id="numeric_primary">
        <one-of id="00106" ambiguous="true">
            <element ref-id="value_expression_primary" />
            <element ref-id="numeric_value_function" />
        </one-of>
    </element-def>
    <element-def description="Value expression primary" id="value_expression_primary">
        <one-of id="00107" ambiguous="true">
            <element ref-id="unsigned_value_specification" />
            <element ref-id="column_reference" />
            <element ref-id="set_function_specification" />
            <element ref-id="scalar_subquery" />
            <element ref-id="case_expression" />
            <sequence id="00108">
                <token id="00109" type-id="CHR_LEFT_PARENTHESIS" />
                <element ref-id="value_expression" />
                <token id="00110" type-id="CHR_RIGHT_PARENTHESIS" />
            </sequence>
            <element ref-id="cast_specification" />
        </one-of>
    </element-def>
    <element-def description="Unsigned value specification" id="unsigned_value_specification">
        <one-of id="00111" ambiguous="true">
            <element ref-id="unsigned_literal" />
            <element ref-id="general_value_specification" />
        </one-of>
    </element-def>
    <element-def description="Unsigned literal" id="unsigned_literal">
        <one-of id="00112">
            <element ref-id="unsigned_numeric_literal" />
            <element ref-id="general_literal" />
        </one-of>
    </element-def>
    <element-def description="Unsigned numeric literal" id="unsigned_numeric_literal">
        <one-of id="00113">
            <token type-id="NUMBER" id="00114" />
            <token type-id="INTEGER" id="00115" />
        </one-of>
    </element-def>
    <element-def description="General literal" id="general_literal">
        <one-of id="00116">
            <token type-id="STRING" id="00117" />
            <token type-id="KW_NULL" id="00118" />
            <token type-id="KW_TRUE" id="00119" />
            <token type-id="KW_FALSE" id="00120" />
        </one-of>
    </element-def>
    <element-def description="Numeric value function" id="numeric_value_function">
        <element ref-id="routine_invocation" />
    </element-def>
    <element-def description="Set function specification" id="set_function_specification">
        <element ref-id="set_function_type" />
        <wrapper template="PARENTHESES" id="00121">
            <one-of id="00122" ambiguous="true">
                <token type-id="CHR_STAR" id="00123" />
                <sequence id="00124">
                    <element optional="true" ref-id="set_quantifier" />
                    <element ref-id="value_expression" />
                </sequence>
            </one-of>
        </wrapper>
    </element-def>
    <element-def description="Set function type" id="set_function_type">
        <one-of id="00125">
            <token type-id="FN_AVG" id="00126" />
            <token type-id="FN_COUNT" id="00127" />
            <token type-id="FN_MAX" id="00128" />
            <token type-id="FN_MIN" id="00129" />
            <token type-id="FN_SUM" id="00130" />
        </one-of>
    </element-def>
    <element-def description="Routine invocation" id="routine_invocation">
        <token type-id="IDENTIFIER" original-name="routine_name" id="00131" />
        <wrapper template="PARENTHESES" id="00132">
            <iteration optional="true" separator="CHR_COMMA" id="00133">
                <element ref-id="value_expression" />
            </iteration>
        </wrapper>
    </element-def>
    <element-def description="Scalar subquery" id="scalar_subquery">
        <element ref-id="table_subquery" />
    </element-def>
    <element-def description="Case expression" id="case_expression">
        <token type-id="KW_CASE" id="00134" />
        <one-of id="00135" ambiguous="true">
            <element ref-id="simple_case" />
            <element ref-id="searched_case" />
