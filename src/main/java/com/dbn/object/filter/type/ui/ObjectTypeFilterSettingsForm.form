<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.dbn.object.filter.type.ui.ObjectTypeFilterSettingsForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="4" left="4" bottom="4" right="4"/>
    <constraints>
      <xy x="20" y="20" width="234" height="302"/>
    </constraints>
    <properties/>
    <border type="none" title-resource-bundle="messages/DBNResources" title-key="cfg.browser.title.VisibleObjectTypes"/>
    <children>
      <component id="85543" class="javax.swing.JLabel" binding="visibleObjectTypesLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="eeced"/>
          <text resource-bundle="messages/DBNResources" key="cfg.browser.label.VisibleObjectTypes"/>
        </properties>
      </component>
      <component id="45cf9" class="javax.swing.JCheckBox" binding="useMasterSettingsCheckBox">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="220" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <margin top="0" left="0" bottom="0" right="0"/>
          <text resource-bundle="messages/DBNResources" key="cfg.browser.label.UseProjectSettings"/>
          <verticalAlignment value="0"/>
        </properties>
      </component>
      <scrollpane id="f8f77" class="com.intellij.ui.components.JBScrollPane" binding="visibleObjectsScrollPane">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="300" height="-1"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none">
          <color color="-16777216"/>
        </border>
        <children>
          <component id="eeced" class="com.dbn.common.ui.list.CheckBoxList" binding="visibleObjectsList">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
