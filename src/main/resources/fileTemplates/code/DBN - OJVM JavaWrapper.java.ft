EXECUTE IMMEDIATE
'
CREATE OR REPLACE AND COMPILE JAVA SOURCE NAMED "${JAVA_WRAPPER_NAME}" AS

public class ${JAVA_WRAPPER_NAME} {

    #if($JAVA_WRAPPER_METHODS)
        #foreach($javaWrapperMethod in $JAVA_WRAPPER_METHODS)
            $javaWrapperMethod
        #end
    #end


    #if($SQL_CONVERSION_METHODS)
        #foreach($sqlMethod in $SQL_CONVERSION_METHODS)
            $sqlMethod
        #end
    #end

    #if($JAVA_CONVERSION_METHODS)
        #foreach($javaMethod in $JAVA_CONVERSION_METHODS)
            $javaMethod
        #end
    #end
}
';