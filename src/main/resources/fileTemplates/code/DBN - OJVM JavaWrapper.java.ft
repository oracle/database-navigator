EXECUTE IMMEDIATE
'
CREATE OR REPLACE AND COMPILE JAVA SOURCE NAMED "${JAVA_WRAPPER_NAME}" AS

#foreach($JAVA_IMPORT_PACKAGE in $JAVA_IMPORT_PACKAGES)
import $JAVA_IMPORT_PACKAGE.*;
#end


public class ${JAVA_WRAPPER_NAME} {

#foreach($JAVA_WRAPPER_METHOD in $JAVA_WRAPPER_METHODS)
$JAVA_WRAPPER_METHOD
$BR
#end


#foreach($SQL_CONVERSION_METHOD in $SQL_CONVERSION_METHODS)
$SQL_CONVERSION_METHOD
$BR
#end

#foreach($JAVA_CONVERSION_METHOD in $JAVA_CONVERSION_METHODS)
$JAVA_CONVERSION_METHOD
$BR
#end

#foreach($CODE_WRAPPER_METHOD in $CODE_WRAPPER_METHODS)
$CODE_WRAPPER_METHOD
$BR
#end
}
';