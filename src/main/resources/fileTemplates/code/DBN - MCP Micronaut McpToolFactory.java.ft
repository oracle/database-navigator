package com.dbn.mcp.server;

import io.modelcontextprotocol.json.McpJsonDefaults;
import io.modelcontextprotocol.json.McpJsonMapper;
import io.modelcontextprotocol.server.McpServerFeatures;
import io.modelcontextprotocol.server.McpStatelessServerFeatures;
import io.modelcontextprotocol.spec.McpSchema;

import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * Turns the YAML tool definitions into MCP tool specifications.
 * Tools are dynamic, so they are registered as specification instances
 * rather than annotated methods.
 */
public class McpToolFactory {
    private static final McpJsonMapper MAPPER = McpJsonDefaults.getMapper();

    private final SqlToolExecutor toolExecutor;

    public McpToolFactory(SqlToolExecutor toolExecutor) {
        this.toolExecutor = toolExecutor;
    }

    /**
     * Tool specifications for the stdio transport.
     */
    public List<McpServerFeatures.SyncToolSpecification> createToolSpecifications(Map<String, ToolConfig> tools) {
        List<McpServerFeatures.SyncToolSpecification> specs = new ArrayList<>();
        for (Map.Entry<String, ToolConfig> entry : tools.entrySet()) {
            ToolConfig toolConfig = entry.getValue();
            specs.add(McpServerFeatures.SyncToolSpecification.builder()
                    .tool(buildTool(entry.getKey(), toolConfig))
                    .callHandler((exchange, request) -> toolExecutor.execute(toolConfig, request.arguments()))
                    .build());
        }
        return specs;
    }

    /**
     * Stateless tool specifications for the HTTP transport: safe under concurrent requests.
     */
    public List<McpStatelessServerFeatures.SyncToolSpecification> createStatelessToolSpecifications(Map<String, ToolConfig> tools) {
        List<McpStatelessServerFeatures.SyncToolSpecification> specs = new ArrayList<>();
        for (Map.Entry<String, ToolConfig> entry : tools.entrySet()) {
            ToolConfig toolConfig = entry.getValue();
            specs.add(McpStatelessServerFeatures.SyncToolSpecification.builder()
                    .tool(buildTool(entry.getKey(), toolConfig))
                    .callHandler((context, request) -> toolExecutor.execute(toolConfig, request.arguments()))
                    .build());
        }
        return specs;
    }

    private McpSchema.Tool buildTool(String toolName, ToolConfig toolConfig) {
        return McpSchema.Tool.builder()
                .name(toolName)
                .description(toolConfig.description)
                .inputSchema(MAPPER, toolConfig.buildInputSchemaJson(MAPPER))
                .build();
    }
}
