#if(${IS_PACKAGE_FORMAT} && ${IS_PACKAGE_FORMAT} == true)
EXECUTE IMMEDIATE
'
CREATE OR REPLACE PACKAGE ${SQL_WRAPPER_NAME} AS
#foreach($WRAPPER_METHOD in $WRAPPER_METHODS)
    #if($WRAPPER_METHOD.IS_PROCEDURE)
        PROCEDURE ${WRAPPER_METHOD.SQL_METHOD_NAME}${WRAPPER_METHOD.SQL_PARAMETERS};
    #else
        FUNCTION ${WRAPPER_METHOD.SQL_METHOD_NAME}${WRAPPER_METHOD.SQL_PARAMETERS} RETURN ${WRAPPER_METHOD.SQL_RETURN_TYPE};
    #end
#end
END ${SQL_WRAPPER_NAME};
';

EXECUTE IMMEDIATE
'
CREATE OR REPLACE PACKAGE BODY ${SQL_WRAPPER_NAME} AS
#foreach($WRAPPER_METHOD in $WRAPPER_METHODS)
    #if($WRAPPER_METHOD.IS_PROCEDURE)
        PROCEDURE ${WRAPPER_METHOD.SQL_METHOD_NAME}${WRAPPER_METHOD.SQL_PARAMETERS}
        AS LANGUAGE JAVA NAME ''${JAVA_WRAPPER_NAME}.${WRAPPER_METHOD.JAVA_METHOD_NAME}${WRAPPER_METHOD.JAVA_PARAMETERS}'';
    #else
        FUNCTION ${WRAPPER_METHOD.SQL_METHOD_NAME}${WRAPPER_METHOD.SQL_PARAMETERS} RETURN ${WRAPPER_METHOD.SQL_RETURN_TYPE}
        AS LANGUAGE JAVA NAME ''${JAVA_WRAPPER_NAME}.${WRAPPER_METHOD.JAVA_METHOD_NAME}${WRAPPER_METHOD.JAVA_PARAMETERS} return ${WRAPPER_METHOD.JAVA_RETURN_TYPE}'';
    #end
#end
END ${SQL_WRAPPER_NAME};
';

#else

EXECUTE IMMEDIATE
'
#foreach($WRAPPER_METHOD in $WRAPPER_METHODS)
    #if($WRAPPER_METHOD.IS_PROCEDURE)
        CREATE OR REPLACE PROCEDURE ${SQL_WRAPPER_NAME}${WRAPPER_METHOD.SQL_PARAMETERS}
        AS LANGUAGE JAVA NAME ''${JAVA_WRAPPER_NAME}.${WRAPPER_METHOD.JAVA_METHOD_NAME}${WRAPPER_METHOD.JAVA_PARAMETERS}'';
    #else
        CREATE OR REPLACE FUNCTION ${SQL_WRAPPER_NAME}${WRAPPER_METHOD.SQL_PARAMETERS} RETURN ${WRAPPER_METHOD.SQL_RETURN_TYPE}
        AS LANGUAGE JAVA NAME ''${JAVA_WRAPPER_NAME}.${WRAPPER_METHOD.JAVA_METHOD_NAME}${WRAPPER_METHOD.JAVA_PARAMETERS} return ${WRAPPER_METHOD.JAVA_RETURN_TYPE}'';
    #end
#end
';

#end