#if(${IS_PACKAGE_FORMAT} && ${IS_PACKAGE_FORMAT} == true)
EXECUTE IMMEDIATE
'
CREATE OR REPLACE PACKAGE ${SQL_WRAPPER_NAME} AS
#foreach($method in $JAVA_METHODS)
    #if($method.isVoid)
    PROCEDURE ${method.wrapperJavaMethodName}(${method.sqlSignature});
    #else
    FUNCTION ${method.wrapperJavaMethodName}(${method.sqlSignature}) RETURN ${method.sqlReturnType};
    #end
#end
END ${SQL_WRAPPER_NAME};
';

EXECUTE IMMEDIATE
'
CREATE OR REPLACE PACKAGE BODY ${SQL_WRAPPER_NAME} AS
#foreach($method in $JAVA_METHODS)
    #if($method.isVoid)
    PROCEDURE ${method.wrapperJavaMethodName}(${method.sqlSignature})
    AS LANGUAGE JAVA NAME ''${JAVA_WRAPPER_NAME}.${method.wrapperJavaMethodName}(${method.javaSignature})'';
    #else
    FUNCTION ${method.wrapperJavaMethodName}(${method.sqlSignature}) RETURN ${method.sqlReturnType}
    AS LANGUAGE JAVA NAME ''${JAVA_WRAPPER_NAME}.${method.wrapperJavaMethodName}(${method.javaSignature}) return ${method.resolvedReturnType}'';
    #end
#end
END ${SQL_WRAPPER_NAME};
';

#else

EXECUTE IMMEDIATE
'
#foreach($method in $JAVA_METHODS)
    #if($method.isVoid)
    CREATE OR REPLACE PROCEDURE ${SQL_WRAPPER_NAME}(${method.sqlSignature()})
    AS LANGUAGE JAVA NAME ''${JAVA_WRAPPER_NAME}.${method.wrapperJavaMethodName}(${method.javaSignature})'';
    #else
    CREATE OR REPLACE FUNCTION ${SQL_WRAPPER_NAME}(${method.sqlSignature}) RETURN ${method.sqlReturnType}
    AS LANGUAGE JAVA NAME ''${JAVA_WRAPPER_NAME}.${method.wrapperJavaMethodName}(${method.javaSignature}) return ${method.resolvedReturnType}'';
    #end
#end
';

#end