DECLARE
    PROCEDURE execute_immediate(statement IN VARCHAR2) IS
    BEGIN
        EXECUTE IMMEDIATE statement;
    EXCEPTION
        WHEN OTHERS THEN
        dbms_output.put_line('SQLERRM: ' || SQLERRM);
    END;
BEGIN
    execute_immediate('DROP ${SQL_WRAPPER_TYPE} ${SQL_WRAPPER_NAME}');

    #foreach($SQL_TYPE_NAME in $SQL_TYPE_NAMES)
        execute_immediate('DROP TYPE $SQL_TYPE_NAME FORCE');
    #end

    execute_immediate('DROP JAVA SOURCE ${JAVA_WRAPPER_NAME}');
END;