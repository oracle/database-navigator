import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ArrayNode;
import com.fasterxml.jackson.databind.node.JsonNodeFactory;
import com.fasterxml.jackson.databind.node.ObjectNode;
import oracle.jdbc.OracleConnection;
import io.modelcontextprotocol.server.McpServer;
import io.modelcontextprotocol.server.McpServerFeatures;
import io.modelcontextprotocol.server.transport.StdioServerTransportProvider;
import io.modelcontextprotocol.spec.McpSchema;
import oracle.jdbc.OraclePreparedStatement;
import org.yaml.snakeyaml.Yaml;

import java.io.Reader;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.sql.*;
import java.util.*;

public class Main {

    private static final String SERVER_NAME = "${SERVER_NAME}";
    private static final ObjectMapper MAPPER = new ObjectMapper();

    private static Connection connection;
    private static Path sepsWalletDir;

    public static void main(String[] args) throws Exception {
        Path jarDir = getJarDir();

        Path configFile = args.length > 0
                ? Paths.get(args[0])
                : jarDir.resolve("mcp-config.yaml");
        if (!Files.exists(configFile))
            throw new IllegalStateException("mcp-config.yaml not found at: " + configFile);

        McpConfig config;
        try (Reader reader = Files.newBufferedReader(configFile, StandardCharsets.UTF_8)) {
            config = new Yaml().loadAs(reader, McpConfig.class);
        }

        Path walletDir = jarDir.resolve("wallet");
        if (!Files.isDirectory(walletDir))
            throw new IllegalStateException("Wallet directory not found at: " + walletDir);

        sepsWalletDir = walletDir;
        connection = config.dataSource.connect(walletDir);

        List<McpServerFeatures.SyncToolSpecification> specs = new ArrayList<>();
        for (Map.Entry<String, ToolConfig> entry : config.tools.entrySet()) {
            specs.add(createTool(entry.getKey(), entry.getValue(), config.dataSource));
        }

        McpServer.sync(new StdioServerTransportProvider(MAPPER))
                .serverInfo(SERVER_NAME, "1.0.0")
                .capabilities(McpSchema.ServerCapabilities.builder()
                        .tools(true)
                        .logging()
                        .build())
                .tools(specs)
                .build();

        // To use HTTP instead, replace the block above with:
        // startHttpServer(specs);
    }

