    private static synchronized Connection getConnection(DataSourceConfig ds) throws SQLException {
        if (connection == null || !connection.isValid(2))
            connection = ds.connect(sepsWalletDir);
        return connection;
    }

    @FunctionalInterface
    interface McpCallable {
        McpSchema.CallToolResult call() throws Exception;
    }

    private static McpSchema.CallToolResult tryCall(McpCallable callable) {
        try {
            return callable.call();
        } catch (Exception ex) {
            connection = null;
            return McpSchema.CallToolResult.builder()
                    .isError(true)
                    .addTextContent(ex.getMessage())
                    .build();
        }
    }

    private static List<Map<String, Object>> rsToList(ResultSet rs) throws SQLException {
        List<Map<String, Object>> out = new ArrayList<>();
        ResultSetMetaData md = rs.getMetaData();
        int cols = md.getColumnCount();
        while (rs.next()) {
            Map<String, Object> row = new LinkedHashMap<>();
            for (int i = 1; i <= cols; i++) {
                Object value = rs.getObject(i);
                if (value instanceof Clob clob) value = clob.getSubString(1, (int) clob.length());
                row.put(md.getColumnLabel(i), value);
            }
            out.add(row);
        }
        return out;
    }

    private static McpServerFeatures.SyncToolSpecification createTool(
            String toolName, ToolConfig tc, DataSourceConfig ds) {
        return McpServerFeatures.SyncToolSpecification.builder()
                .tool(McpSchema.Tool.builder()
                        .name(toolName)
                        .description(tc.description)
                        .inputSchema(tc.buildInputSchemaJson())
                        .build())
                .callHandler((exchange, callReq) -> tryCall(() -> {
                    Connection conn = getConnection(ds);
                    try (OraclePreparedStatement ps =
                                 (OraclePreparedStatement) conn.prepareStatement(tc.statement)) {
                        if (tc.parameters != null) {
                            for (ToolParameterConfig param : tc.parameters) {
                                ps.setObjectAtName(param.name, callReq.arguments().get(param.name));
                            }
                        }
                        try (ResultSet rs = ps.executeQuery()) {
                            List<Map<String, Object>> rows = rsToList(rs);
                            return McpSchema.CallToolResult.builder()
                                    .structuredContent(Map.of("rows", rows, "rowCount", rows.size()))
                                    .addTextContent(MAPPER.writeValueAsString(rows))
                                    .build();
                        }
                    }
                }))
                .build();
    }

    private static Path getJarDir() throws Exception {
        return Paths.get(
                Main.class.getProtectionDomain().getCodeSource().getLocation().toURI()).getParent();
    }

    public static class McpConfig {
        public DataSourceConfig dataSource;
        public Map<String, ToolConfig> tools = new LinkedHashMap<>();
    }

    public static class DataSourceConfig {
        public String url;
        public String username; // optional — overrides wallet if set
        public String password; // optional — overrides wallet if set

        public Connection connect(Path walletDir) throws SQLException {
            try {
                if (username != null && !username.isBlank()) {
                    return DriverManager.getConnection(url, username, password);
                }

                // Let Oracle JDBC resolve default SEPS credentials from the wallet for this connection.
                Properties properties = new Properties();
                properties.setProperty(
                        OracleConnection.CONNECTION_PROPERTY_SEPS_WALLET_LOCATION,
                        walletDir.toAbsolutePath().toString());
                return DriverManager.getConnection(url, properties);
            } catch (SQLException e) {
                throw new IllegalStateException("Could not connect to database: " + e.getMessage(), e);
            }
        }
    }

    public static class ToolConfig {
        public String description;
        public String statement;
        public List<ToolParameterConfig> parameters;

        public String buildInputSchemaJson() {
            ObjectNode schema = JsonNodeFactory.instance.objectNode();
            schema.put("type", "object");
            ObjectNode properties = schema.putObject("properties");
            ArrayNode required = JsonNodeFactory.instance.arrayNode();
            if (parameters != null) {
                for (ToolParameterConfig param : parameters) {
                    if (param == null) continue;
                    ObjectNode prop = properties.putObject(param.name);
                    prop.put("type", param.type);
                    prop.put("description", param.description);
                    if (param.required) required.add(param.name);
                }
            }
            if (!required.isEmpty()) schema.set("required", required);
            return schema.toString();
        }
    }

    public static class ToolParameterConfig {
        public String name;
        public String type = "string";
        public String description;
        public boolean required;
    }
}
