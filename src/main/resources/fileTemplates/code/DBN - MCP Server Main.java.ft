import io.modelcontextprotocol.json.McpJsonDefaults;
import io.modelcontextprotocol.json.McpJsonMapper;
import io.modelcontextprotocol.server.McpServer;
import io.modelcontextprotocol.server.McpServerFeatures;
import io.modelcontextprotocol.server.transport.HttpServletStreamableServerTransportProvider;
import io.modelcontextprotocol.server.transport.StdioServerTransportProvider;
import io.modelcontextprotocol.spec.McpSchema;
import oracle.jdbc.OracleConnection;
import oracle.jdbc.OraclePreparedStatement;
import org.apache.catalina.Context;
import org.apache.catalina.startup.Tomcat;
import org.yaml.snakeyaml.Yaml;

import java.io.Reader;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.sql.Clob;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.ResultSet;
import java.sql.ResultSetMetaData;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Properties;

public class Main {

    private static final String SERVER_NAME = "${SERVER_NAME}";
    private static final String CONFIG_FILE_NAME = "mcp-config.yaml";
    private static final String WALLET_DIR_NAME = "wallet";
    private static final String TRANSPORT_STDIO = "stdio";
    private static final String TRANSPORT_HTTP = "http";
    private static final String MCP_ENDPOINT = "/mcp";
    private static final int DEFAULT_HTTP_PORT = 8080;
    private static final int CONNECTION_VALIDATION_TIMEOUT_SECONDS = 2;

    private static final McpJsonMapper MAPPER = McpJsonDefaults.getMapper();

    private static Connection connection;
    private static Path sepsWalletDir;

    public static void main(String[] args) throws Exception {
        Path jarDir = resolveJarDir();
        Path configFile = resolveConfigFile(args, jarDir);
        McpConfig config = loadConfig(configFile);

        sepsWalletDir = resolveWalletDir(jarDir);

        List<McpServerFeatures.SyncToolSpecification> toolSpecifications = buildToolSpecifications(config);
        startServer(config, toolSpecifications);
    }

    private static Path resolveConfigFile(String[] args, Path jarDir) {
        Path configFile = args.length > 0
                ? Paths.get(args[0])
                : jarDir.resolve(CONFIG_FILE_NAME);

        if (!Files.exists(configFile)) {
            throw new IllegalStateException(CONFIG_FILE_NAME + " not found at: " + configFile);
        }

        return configFile;
    }

    private static McpConfig loadConfig(Path configFile) throws Exception {
        McpConfig config;
        try (Reader reader = Files.newBufferedReader(configFile, StandardCharsets.UTF_8)) {
            config = new Yaml().loadAs(reader, McpConfig.class);
        }

        if (config == null) {
            throw new IllegalStateException(CONFIG_FILE_NAME + " is empty or invalid");
        }
        if (config.dataSource == null) {
            throw new IllegalStateException("dataSource section is missing in " + CONFIG_FILE_NAME);
        }
        if (config.tools == null) {
            config.tools = new LinkedHashMap<>();
        }

        return config;
    }

    private static Path resolveWalletDir(Path jarDir) {
        Path walletDir = jarDir.resolve(WALLET_DIR_NAME);
        if (!Files.isDirectory(walletDir)) {
            throw new IllegalStateException("Wallet directory not found at: " + walletDir);
        }
        return walletDir;
    }

    private static List<McpServerFeatures.SyncToolSpecification> buildToolSpecifications(McpConfig config) {
        List<McpServerFeatures.SyncToolSpecification> specs = new ArrayList<>();
        for (Map.Entry<String, ToolConfig> entry : config.tools.entrySet()) {
            specs.add(createTool(entry.getKey(), entry.getValue(), config.dataSource));
        }
        return specs;
    }

    private static void startServer(McpConfig config, List<McpServerFeatures.SyncToolSpecification> specs) throws Exception {
        if (isHttpTransport(config.transport)) {
            startHttpServer(specs, resolveHttpPort(config.httpPort));
        } else {
            startStdioServer(specs);
        }
    }

    private static boolean isHttpTransport(String transport) {
        String value = transport == null ? TRANSPORT_STDIO : transport.trim().toLowerCase(Locale.ROOT);
        if ("streamablehttp".equals(value) || "streamable-http".equals(value)) {
            value = TRANSPORT_HTTP;
        }

        return switch (value) {
            case TRANSPORT_HTTP -> true;
            case TRANSPORT_STDIO -> false;
            default -> throw new IllegalStateException(
                    "Unsupported transport '" + transport + "'. Use 'stdio' or 'http'.");
        };
    }

    private static int resolveHttpPort(Integer port) {
        int value = port == null ? DEFAULT_HTTP_PORT : port;
        if (value < 1 || value > 65535) {
            throw new IllegalStateException("Invalid httpPort '" + value + "'. Use a value between 1 and 65535.");
        }
        return value;
    }

    private static void startStdioServer(List<McpServerFeatures.SyncToolSpecification> specs) {
        McpServer.sync(new StdioServerTransportProvider(MAPPER))
                .serverInfo(SERVER_NAME, "1.0.0")
                .capabilities(McpSchema.ServerCapabilities.builder()
                        .tools(true)
                        .logging()
                        .build())
                .tools(specs)
                .build();
    }

    private static void startHttpServer(List<McpServerFeatures.SyncToolSpecification> specs, int port) throws Exception {
        HttpServletStreamableServerTransportProvider transport =
                HttpServletStreamableServerTransportProvider.builder()
                        .jsonMapper(MAPPER)
                        .mcpEndpoint(MCP_ENDPOINT)
                        .build();

        McpServer.sync(transport)
                .serverInfo(SERVER_NAME, "1.0.0")
                .capabilities(McpSchema.ServerCapabilities.builder()
                        .tools(true)
                        .logging()
                        .build())
                .tools(specs)
                .build();

        Path tomcatBaseDir = Paths.get(System.getProperty("java.io.tmpdir"), SERVER_NAME + "-tomcat");
        Files.createDirectories(tomcatBaseDir);

        Tomcat tomcat = new Tomcat();
        tomcat.setBaseDir(tomcatBaseDir.toString());
        tomcat.setPort(port);
        tomcat.getConnector();

        Context context = tomcat.addContext("", tomcatBaseDir.toString());
        Tomcat.addServlet(context, "mcpServlet", transport);
        context.addServletMappingDecoded(MCP_ENDPOINT + "/*", "mcpServlet");

        tomcat.start();
        tomcat.getServer().await();
    }

    private static synchronized Connection getConnection(DataSourceConfig dataSource) throws SQLException {
        if (connection == null || !connection.isValid(CONNECTION_VALIDATION_TIMEOUT_SECONDS)) {
            connection = dataSource.connect(sepsWalletDir);
        }
        return connection;
    }

    @FunctionalInterface
    interface McpCallable {
        McpSchema.CallToolResult call() throws Exception;
    }

    private static McpSchema.CallToolResult tryCall(McpCallable callable) {
        try {
            return callable.call();
        } catch (Exception ex) {
            connection = null;
            String message = ex.getMessage() != null ? ex.getMessage() : ex.getClass().getSimpleName();
            return McpSchema.CallToolResult.builder()
                    .isError(true)
                    .addTextContent(message)
                    .build();
        }
    }

    private static List<Map<String, Object>> rsToList(ResultSet rs) throws SQLException {
        List<Map<String, Object>> out = new ArrayList<>();
        ResultSetMetaData md = rs.getMetaData();
        int cols = md.getColumnCount();

        while (rs.next()) {
            Map<String, Object> row = new LinkedHashMap<>();
            for (int i = 1; i <= cols; i++) {
                Object value = rs.getObject(i);
                if (value instanceof Clob clob) {
                    value = clob.getSubString(1, (int) clob.length());
                }
                row.put(md.getColumnLabel(i), value);
            }
            out.add(row);
        }

        return out;
    }

    private static McpServerFeatures.SyncToolSpecification createTool(
            String toolName,
            ToolConfig toolConfig,
            DataSourceConfig dataSource) {

        return McpServerFeatures.SyncToolSpecification.builder()
                .tool(McpSchema.Tool.builder()
                        .name(toolName)
                        .description(toolConfig.description)
                        .inputSchema(MAPPER, toolConfig.buildInputSchemaJson())
                        .build())
                .callHandler((exchange, callReq) -> tryCall(() -> {
                    Connection conn = getConnection(dataSource);
                    try (OraclePreparedStatement ps = (OraclePreparedStatement) conn.prepareStatement(toolConfig.statement)) {
                        if (toolConfig.parameters != null) {
                            for (ToolParameterConfig param : toolConfig.parameters) {
                                ps.setObjectAtName(param.name, callReq.arguments().get(param.name));
                            }
                        }

                        try (ResultSet rs = ps.executeQuery()) {
                            List<Map<String, Object>> rows = rsToList(rs);
                            return McpSchema.CallToolResult.builder()
                                    .structuredContent(Map.of("rows", rows, "rowCount", rows.size()))
                                    .addTextContent(MAPPER.writeValueAsString(rows))
                                    .build();
                        }
                    }
                }))
                .build();
    }

    private static Path resolveJarDir() throws Exception {
        return Paths.get(Main.class.getProtectionDomain().getCodeSource().getLocation().toURI()).getParent();
    }

    public static class McpConfig {
        public String transport = TRANSPORT_STDIO;
        public Integer httpPort = DEFAULT_HTTP_PORT;
        public DataSourceConfig dataSource;
        public Map<String, ToolConfig> tools = new LinkedHashMap<>();
    }

    public static class DataSourceConfig {
        public String url;
        public String username; // optional — overrides wallet if set
        public String password; // optional — overrides wallet if set

        public Connection connect(Path walletDir) throws SQLException {
            try {
                if (username != null && !username.isBlank()) {
                    return DriverManager.getConnection(url, username, password);
                }

                // Let Oracle JDBC resolve default SEPS credentials from the wallet for this connection.
                Properties properties = new Properties();
                properties.setProperty(
                        OracleConnection.CONNECTION_PROPERTY_SEPS_WALLET_LOCATION,
                        walletDir.toAbsolutePath().toString());
                return DriverManager.getConnection(url, properties);
            } catch (SQLException e) {
                throw new IllegalStateException("Could not connect to database: " + e.getMessage(), e);
            }
        }
    }

    public static class ToolConfig {
        public String description;
        public String statement;
        public List<ToolParameterConfig> parameters;

        public String buildInputSchemaJson() {
            Map<String, Object> schema = new LinkedHashMap<>();
            schema.put("type", "object");

            Map<String, Object> properties = new LinkedHashMap<>();
            List<String> required = new ArrayList<>();

            if (parameters != null) {
                for (ToolParameterConfig param : parameters) {
                    if (param == null) {
                        continue;
                    }

                    Map<String, Object> property = new LinkedHashMap<>();
                    property.put("type", param.type);
                    property.put("description", param.description);
                    properties.put(param.name, property);

                    if (param.required) {
                        required.add(param.name);
                    }
                }
            }

            schema.put("properties", properties);
            if (!required.isEmpty()) {
                schema.put("required", required);
            }

            try {
                return MAPPER.writeValueAsString(schema);
            } catch (Exception e) {
                throw new IllegalStateException("Could not build tool input schema", e);
            }
        }
    }

    public static class ToolParameterConfig {
        public String name;
        public String type = "string";
        public String description;
        public boolean required;
    }
}
