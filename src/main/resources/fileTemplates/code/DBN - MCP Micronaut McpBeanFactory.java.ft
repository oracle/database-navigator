package com.dbn.mcp.server;

import io.micronaut.context.annotation.Context;
import io.micronaut.context.annotation.EachBean;
import io.micronaut.context.annotation.Factory;
import io.modelcontextprotocol.json.McpJsonDefaults;
import io.modelcontextprotocol.json.McpJsonMapper;
import io.modelcontextprotocol.server.McpStatelessServerFeatures;
import io.modelcontextprotocol.spec.McpSchema;
import jakarta.inject.Singleton;
import oracle.jdbc.OracleConnection;
import oracle.ucp.jdbc.PoolDataSource;
import oracle.ucp.jdbc.PoolDataSourceFactory;

import java.nio.file.Path;
import java.sql.SQLException;

/** Produces the UCP datasource and MCP tools configured in mcp-config.yml. */
@Factory
public class McpBeanFactory {
    private static final McpJsonMapper MAPPER = McpJsonDefaults.getMapper();

    // Supplied by the Graal runtime when this server is deployed as a Graal application.
    // Their presence switches the datasource to token authentication - no wallet, no
    // username/password and no connection string are baked into the deployed image.
    private static final String ENV_DATABASE_URL = "DATABASE_URL";
    private static final String ENV_DB_TOKEN_LOCATION = "OCI_GRAAL_DB_TOKEN";

    @Singleton
    PoolDataSource dataSource(DataSourceConfig config) throws SQLException {
        PoolDataSource pool = PoolDataSourceFactory.getPoolDataSource();
        pool.setConnectionFactoryClassName("oracle.jdbc.pool.OracleDataSource");

        String databaseUrl = System.getenv(ENV_DATABASE_URL);
        String tokenLocation = System.getenv(ENV_DB_TOKEN_LOCATION);
        boolean hasUrl = databaseUrl != null && !databaseUrl.isBlank();
        boolean hasToken = tokenLocation != null && !tokenLocation.isBlank();

        if (hasUrl && hasToken) {
            // Graal-managed deployment: the platform provides the connection string and a
            // periodically refreshed database token for an application-specific DB user.
            pool.setURL("jdbc:oracle:thin:@" + databaseUrl);
            pool.setConnectionProperty(
                    OracleConnection.CONNECTION_PROPERTY_TOKEN_AUTHENTICATION, "OCI_TOKEN");
            pool.setConnectionProperty(
                    OracleConnection.CONNECTION_PROPERTY_TOKEN_LOCATION, tokenLocation);
            return pool;
        }
        if (hasUrl || hasToken) {
            // never include the values themselves in the message - they are credentials material
            throw new IllegalStateException(
                    "Incomplete Graal database environment: both " + ENV_DATABASE_URL + " and "
                            + ENV_DB_TOKEN_LOCATION + " must be set, but only one was provided.");
        }

        // local execution: wallet or explicit credentials from mcp-config.yml
        pool.setURL(config.getUrl());
        if (config.usesExplicitCredentials()) {
            pool.setUser(config.getUsername());
            pool.setPassword(config.getPassword());
        } else {
            String walletDir = config.getWalletDir();
            if (walletDir == null || walletDir.isBlank()) {
                // no Graal env, no explicit credentials and no wallet: fail with a clear message
                // rather than a NullPointerException from Path.of(null)
                throw new IllegalStateException(
                        "No database configuration found: expected either the Graal runtime "
                                + "environment (" + ENV_DATABASE_URL + " and " + ENV_DB_TOKEN_LOCATION
                                + "), explicit credentials, or a wallet directory in mcp-config.yml.");
            }
            pool.setConnectionProperty(
                    OracleConnection.CONNECTION_PROPERTY_SEPS_WALLET_LOCATION,
                    Path.of(walletDir).toAbsolutePath().toString());
        }
        return pool;
    }

    @Singleton
    @Context
    @EachBean(ToolConfig.class)
    McpStatelessServerFeatures.SyncToolSpecification toolSpecification(
            ToolConfig toolConfig, SqlToolExecutor toolExecutor) {

        McpSchema.Tool tool = McpSchema.Tool.builder()
                .name(toolConfig.getName())
                .description(toolConfig.getDescription())
                .inputSchema(MAPPER, toolConfig.buildInputSchemaJson(MAPPER))
                .build();
        return McpStatelessServerFeatures.SyncToolSpecification.builder()
                .tool(tool)
                .callHandler((context, request) -> toolExecutor.execute(toolConfig, request.arguments()))
                .build();
    }
}
