    #if (${AUTH_TYPE} == 'USER_PASSWORD')
      #set( $password_env_var_name = 'JDBC_DB_PASSWORD' )
      #set( $error_message = '"Your connection is using password authentication, you must set the value on the JDBC_DB_PASSWORD environment variable"' )
      #set( $system_property_name = 'JDBC_DB_PASSWORD' )
    #elseif (${AUTH_TYPE} == 'TOKEN' && ${AUTH_TOKEN_TYPE} == 'AZURE_SERVICE_PRINCIPAL_SECRET')
       #set( $password_env_var_name = '"AZURE_TOKEN_CLIENT_SECRET_TOKEN"' )
       #set( $error_message1 = 'Your connection is using Azure Service Principal with secret token authentication,')
       #set( $error_message2 = 'you must set the value on the AZURE_TOKEN_CLIENT_SECRET_TOKEN environment variable to pass the secret token.')
       #set( $system_property_name = 'PROP_AZURE_TOKEN_CLIENT_SECRET_TOKEN' )
    #elseif (${AUTH_TYPE} == 'TOKEN' && ${AUTH_TOKEN_TYPE} == 'AZURE_SERVICE_PRINCIPAL_CERT' &&
                    ${AZURE_TOKEN_CLIENT_SECRET_FILE_PASSWORD})
       #set( $password_env_var_name = '"AZURE_TOKEN_CLIENT_SECRET_FILE_PASSWORD"' )
       #set( $error_message1 = 'Your connection is using Azure Service Principal with protected certificate authentication,')
       #set( $error_message2 = 'you must set the value on the AZURE_TOKEN_CLIENT_SECRET_FILE_PASSWORD environment variable to decrypt the certificate file.')
       #set( $system_property_name = 'PROP_AZURE_TOKEN_CLIENT_SECRET_FILE_PASSWORD' )
    #end
  #if (${password_env_var_name})
    /**
     * Load secret from system environment
     */
    private static void readSecret() {
        String secret = System.getenv(${password_env_var_name});
        if (secret == null) {
            String errorMessage = "${error_message1}" +
                                    "${error_message2}";
            throw new AssertionError(errorMessage);
        }
        System.setProperty(${system_property_name}, secret);
    }
#end