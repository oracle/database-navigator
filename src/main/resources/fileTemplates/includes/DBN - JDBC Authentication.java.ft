#if (${AUTH_TYPE} == 'NONE')
    // no authentication
#elseif (${AUTH_TYPE} == 'USER_PASSWORD')
    // user-name and password authentication
    String userName = #if (${USER_NAME})"${USER_NAME}";#else null; // TODO please specify User Name#end
    String password = System.getProperty(JDBC_DB_PASSWORD);
    properties.put(PROP_USER, userName);
    properties.put(PROP_PASSWORD, password);
#elseif (${AUTH_TYPE} == 'USER')
    // user-name authentication
    String userName = #if (${USER_NAME})"${USER_NAME}";#else null; // TODO please specify User Name#end;
    properties.put(PROP_USER, userName);
#elseif (${AUTH_TYPE} == 'OS_CREDENTIALS')
    // os-credentials authentication
#elseif (${AUTH_TYPE} == 'TOKEN')
    #if (${AUTH_TOKEN_TYPE} == 'OCI_API_KEY')
        // OCI API Key token authentication
        String tokenConfigFile = #if (${TOKEN_CONFIG_FILE})"${TOKEN_CONFIG_FILE}";#else null; // TODO please specify the OCI Token Config File#end
        String tokenProfile = #if (${TOKEN_PROFILE})"${TOKEN_PROFILE}";#else null; // TODO please specify OCI Token Profile#end
        properties.put(PROP_TOKEN_AUTH, "OCI_API_KEY");
        properties.put(PROP_OCI_CONFIG_FILE, tokenConfigFile);
        properties.put(PROP_OCI_PROFILE, tokenProfile);
    #elseif (${AUTH_TOKEN_TYPE} == 'OCI_INTERACTIVE')
        // OCI Interactive token authentication
        properties.put(PROP_TOKEN_AUTH, "OCI_INTERACTIVE");
    #elseif (${AUTH_TOKEN_TYPE} == 'AZURE_SERVICE_PRINCIPAL_CERT' || ${AUTH_TOKEN_TYPE} == 'AZURE_SERVICE_PRINCIPAL_SECRET')
        properties.put(PROP_TOKEN_AUTH, "AZURE_SERVICE_PRINCIPAL");
        properties.put(PROP_AZURE_TOKEN_CLIENT_ID, "${AZURE_TOKEN_CLIENT_ID}");
        properties.put(PROP_AZURE_TOKEN_TENANT_ID, "${AZURE_TOKEN_TENANT_ID}");
        properties.put(PROP_AZURE_TOKEN_DATABASE_ID_URI, "${AZURE_TOKEN_DATABASE_ID_URI}");
        #if (${AUTH_TOKEN_TYPE} == 'AZURE_SERVICE_PRINCIPAL_CERT')
        properties.put(PROP_AZURE_TOKEN_CLIENT_SECRET_FILE, "${AZURE_TOKEN_CLIENT_SECRET_FILE}");
           #if (${AZURE_TOKEN_CLIENT_SECRET_FILE_PASSWORD})
              String certificatePassword = System.getProperty(PROP_AZURE_TOKEN_CLIENT_SECRET_FILE_PASSWORD);
              properties.put(PROP_AZURE_TOKEN_CLIENT_SECRET_FILE_PASSWORD, certificatePassword);
           #end
        #elseif (${AUTH_TOKEN_TYPE} == 'AZURE_SERVICE_PRINCIPAL_SECRET')
             String secretToken = System.getProperty(PROP_AZURE_TOKEN_CLIENT_SECRET_TOKEN);
             properties.put(PROP_AZURE_TOKEN_CLIENT_SECRET_TOKEN, secretToken);
        #end
    #elseif (${AUTH_TOKEN_TYPE} == 'AZURE_INTERACTIVE')
        properties.put(PROP_TOKEN_AUTH, "AZURE_INTERACTIVE");
        properties.put(PROP_AZURE_TOKEN_DATABASE_ID_URI, "${AZURE_TOKEN_DATABASE_ID_URI}");
    #end
#end
