#if (${AUTH_TYPE} == 'USER_PASSWORD')
    private static final String PROP_USER = "user";
    private static final String PROP_PASSWORD = "password";
    private static final String JDBC_DB_PASSWORD = "JDBC_DB_PASSWORD";
#elseif (${AUTH_TYPE} == 'USER')
    private static final String PROP_USER = "user";
#elseif (${AUTH_TYPE} == 'TOKEN')
    #if (${AUTH_TOKEN_TYPE} == 'OCI_API_KEY')
        private static final String PROP_TOKEN_AUTH= "oracle.jdbc.tokenAuthentication";
        private static final String PROP_OCI_CONFIG_FILE= "oracle.jdbc.ociConfigFile";
        private static final String PROP_OCI_PROFILE= "oracle.jdbc.ociProfile";
    #elseif (${AUTH_TOKEN_TYPE} == 'OCI_INTERACTIVE')
        private static final String PROP_TOKEN_AUTH= "oracle.jdbc.tokenAuthentication";
    #elseif (${AUTH_TOKEN_TYPE} == 'AZURE_SERVICE_PRINCIPAL_CERT' ||
               ${AUTH_TOKEN_TYPE} == 'AZURE_SERVICE_PRINCIPAL_SECRET')
        private static final String PROP_TOKEN_AUTH= "oracle.jdbc.tokenAuthentication";
        private static final String PROP_AZURE_TOKEN_CLIENT_ID = "oracle.jdbc.clientId";
        private static final String PROP_AZURE_TOKEN_TENANT_ID = "oracle.jdbc.tenantId";
        private static final String PROP_AZURE_TOKEN_DATABASE_ID_URI = "oracle.jdbc.azureDatabaseApplicationIdUri";
        #if (${AUTH_TOKEN_TYPE} == 'AZURE_SERVICE_PRINCIPAL_CERT')
           private static final String PROP_AZURE_TOKEN_CLIENT_SECRET_FILE = "oracle.jdbc.clientCertificate";
           #if (${AZURE_TOKEN_CLIENT_SECRET_FILE_PASSWORD})
               private static final String PROP_AZURE_TOKEN_CLIENT_SECRET_FILE_PASSWORD = "oracle.jdbc.clientCertificatePassword";
           #end
        #elseif (${AUTH_TOKEN_TYPE} == 'AZURE_SERVICE_PRINCIPAL_SECRET')
           private static final String PROP_AZURE_TOKEN_CLIENT_SECRET_TOKEN = "oracle.jdbc.clientSecret";
        #elseif (${AUTH_TOKEN_TYPE} == 'AZURE_SERVICE_INTERACTIVE')
           private static final String PROP_TOKEN_AUTH= "oracle.jdbc.tokenAuthentication";
           private static final String PROP_AZURE_TOKEN_DATABASE_ID_URI = "oracle.jdbc.azureDatabaseApplicationIdUri";
        #end
    #end
#end