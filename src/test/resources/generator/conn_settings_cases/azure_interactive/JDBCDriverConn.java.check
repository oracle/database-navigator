package com.test;
import java.sql.Connection;
import java.sql.Driver;
import java.util.Properties;

/**
 * Oracle JDBC Connector<br>
 * This is generated code. The {@link JdbcConnectorAzureInteractive#connect()} method is implemented to connect to the
 * Oracle Database using the appropriate JDBC Driver.
 *
 * <p><u>DRIVER LIBRARIES</u></p>
 * To run this class you will need to integrate the Oracle JDBC Driver libraries in your project<br>
 * e.g. by using Maven Project Object Model (POM) <a href="https://repo1.maven.org/maven2/com/oracle/database/jdbc/ojdbc11/23.6.0.24.10/ojdbc11-23.6.0.24.10.pom">ojdbc11-23.6.0.24.10.pom</a><br>
 * Additional features may require other libraries to be added to the runtime. Please read the Oracle JDBC documentation for additional details.
 *
 * <p><u>JDBC URL</u></p>
 * The connection is using a JDBC URL of type "TNS"<br>
 * URL pattern: "jdbc:oracle:thin:@{TNS_PROFILE}?TNS_ADMIN="{TNS_FOLDER}""<br>
 * <ul>
 *   <li>TNS_FOLDER: the location of the tnsnames.ora</li>
 *   <li>TNS_PROFILE: the name of the profile definition in tnsnames.ora</li>
 * </ul>
 *
 * <p><u>AUTHENTICATION</u></p>
 * The connection uses "Azure Interactive Token" authentication (AZURE_INTERACTIVE)
 */
public class JdbcConnectorAzureInteractive  {
        private static final String PROP_TOKEN_AUTH = "oracle.jdbc.tokenAuthentication";
        private static final String PROP_AZURE_TOKEN_DATABASE_ID_URI = "oracle.jdbc.azureDatabaseApplicationIdUri";

    /**
     * Creates a jdbc connection to the ORACLE database
     * @return a new {@link Connection}
     * @throws Exception if something goes wrong
     */
    public Connection connect() throws Exception {
        Properties properties = new Properties();

        // JDBC URL
        // ORACLE jdbc url: jdbc:oracle:thin:@<TNS_PROFILE>?TNS_ADMIN="<TNS_FOLDER>"
        String tnsFolder = "/Users/cbateman/git/ojdbc-token-demos-with-secret";
        String tnsProfile = "azure_db";
        String jdbcUrl = "jdbc:oracle:thin:@" + tnsProfile + "?TNS_ADMIN=\"" + tnsFolder + "\"";


        // AUTHENTICATION
        properties.put(PROP_TOKEN_AUTH, "AZURE_INTERACTIVE");
        properties.put(PROP_AZURE_TOKEN_DATABASE_ID_URI, "https://oracledevelopment.onmicrosoft.com/2a0698da-5691-4e06-83bf-fc74c700c04e");

        // PROPERTIES
    // custom properties (e.g. properties.put("charset", "UTF-8");)

        // DRIVER
        // ORACLE driver class "oracle.jdbc.OracleDriver"
        Class<? extends Driver> driverClass = oracle.jdbc.OracleDriver.class;
        Driver driver = driverClass.getConstructor().newInstance();

        // CONNECTION
        return driver.connect(jdbcUrl, properties);
    }

    public static void main(String[] args) {

        JdbcConnectorAzureInteractive connector = new JdbcConnectorAzureInteractive();
        try (Connection connection = connector.connect()) {
            connection.isValid(10);
            System.out.println("INFO: Successfully connected and validated");

        } catch (Exception e) {
            System.out.println("ERROR: Failed to connect. Cause:  " + e.getMessage());
        }
    }

}